---
/**
 * BaseLayout.astro — shared document shell: head, SEO, fonts, base CSS.
 * Pages compose Navbar/Footer/sections inside the slot.
 */
import "../styles/global.css";
import "@fontsource-variable/manrope";
import "@fontsource/dm-serif-display/400.css";
import { site, navLinks } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  schema?: object;
}

const {
  title = site.title,
  description = site.description,
  ogImage = "/og.jpg",
  canonicalPath = Astro.url.pathname,
  schema,
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).toString();

const breadcrumbPath = canonicalPath === "/" ? [] : canonicalPath.split("/").filter(Boolean);
const breadcrumbItems = [
  { "@type": "ListItem", position: 1, name: "Home", item: site.url },
  ...breadcrumbPath.map((segment, i) => ({
    "@type": "ListItem",
    position: i + 2,
    name: segment.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
    item: `${site.url}/${breadcrumbPath.slice(0, i + 1).join("/")}`,
  })),
];

const servicePaths = new Set([
  "sectional-docks",
  "roll-in-docks",
  "platinum-docks",
  "floating-docks",
  "boat-lifts",
  "boat-pontoon-lift-accessories",
  "dock-accessories",
  "lift-accessories",
  "dock-services",
  "dock-services-repair",
  "personal-watercraft-lift",
  "power-canopy",
  "canopy-systems",
]);

const serviceSlug =
  breadcrumbPath.join("/").startsWith("services/")
    ? breadcrumbPath[breadcrumbPath.length - 1]
    : breadcrumbPath.length === 1 && servicePaths.has(breadcrumbPath[0])
      ? breadcrumbPath[0]
      : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": `${site.url}/#business`,
      name: site.legalName,
      url: site.url,
      telephone: `+1-${site.phone}`,
      email: site.email,
      image: `${site.url}/og.jpg`,
      priceRange: "$$",
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address.street,
        addressLocality: site.address.city,
        addressRegion: site.address.state,
        postalCode: site.address.zip,
        addressCountry: "US",
      },
      openingHours: "Mo-Su 07:00-19:00",
      sameAs: [site.facebook, site.googleReviewUrl],
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Waterfront Services",
        itemListElement: navLinks
          .flatMap((link) => (link.children ?? []).map((child) => ({ label: child.label, href: child.href })))
          .filter((child) => child.href && child.href !== "#")
          .map((child) => ({
            "@type": "Offer",
            itemOffered: {
              "@type": "Service",
              name: child.label,
              url: new URL(child.href, site.url).toString(),
            },
          })),
      },
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      url: site.url,
      name: site.name,
      description: site.description,
      publisher: { "@id": `${site.url}/#business` },
      inLanguage: "en-US",
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonical}#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
    ...(serviceSlug
      ? [
          {
            "@type": "Service",
            "@id": `${canonical}#service`,
            name: title,
            description,
            url: canonical,
            provider: { "@id": `${site.url}/#business` },
            areaServed: { "@type": "State", name: "Michigan" },
            serviceType: serviceSlug,
          },
        ]
      : []),
    ...(schema ? [schema] : []),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#071a2b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <script
      is:inline
      >document.documentElement.classList.add("js")</script
    >
    {
      site.facebookPixelId && (
        <script
          is:inline
          set:html={`
            !function(f,b,e,v,n,t,s)
            {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
            fbq('init', '${site.facebookPixelId}');
            fbq('track', 'PageView');
          `}
        />
      )
    }
    {
      site.facebookPixelId && (
        <noscript>
          <img
            height="1"
            width="1"
            style="display:none"
            src={`https://www.facebook.com/tr?id=${site.facebookPixelId}&ev=PageView&noscript=1`}
            alt=""
          />
        </noscript>
      )
    }
    {
      site.gtmId && (
        <script
          is:inline
          set:html={`
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','${site.gtmId}');
          `}
        />
      )
    }
    {
      site.gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    {
      site.ga4Id && (
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${site.ga4Id}');
        `} />
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
