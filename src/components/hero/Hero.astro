---
/**
 * Hero.astro — full-first-viewport hero.
 *
 * Height model (design doc §56):
 *   min-height: 100svh (flex column)
 *   navbar is fixed/overlaying → padding-top reserved in .hero-main
 *   .hero-main flexes to fill, service bar takes natural height
 *
 * Image: absolutely-positioned <Picture> with object-fit: cover —
 * mathematical cropping, no JS, no fixed pixel heights. LCP-optimized:
 * eager, fetchpriority=high, responsive widths, modern formats.
 */
import { Picture } from "astro:assets";
import heroImage from "../../assets/hero/waterfront-hero.png";
import HeroContent from "./HeroContent.astro";
import QuoteForm from "./QuoteForm.astro";
import HeroServicesBar from "./HeroServicesBar.astro";
---

<section class="hero" id="hero" aria-label="Introduction">
  <div class="hero-media">
    <Picture
      src={heroImage}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[640, 828, 1024, 1280, 1536, 1920, 2200, 2560, 3840]}
      sizes="max(100vw, 178vh)"
      alt="Bright Michigan waterfront with dock and boat lift over calm blue lake water"
      quality={62}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      pictureAttributes={{ class: "hero-picture" }}
      class="hero-img"
    />
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-main">
    <div class="site-container hero-grid">
      <HeroContent />
      <QuoteForm />
    </div>
  </div>

  <HeroServicesBar />
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-navy-900);
    /*
      Focal point token — adjust here after visual QA on real screenshots
      without touching component markup.
    */
    --hero-focus-x: center;
    --hero-focus-y: center;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
  }

  .hero-media :global(picture),
  .hero-media :global(.hero-picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-focus-x) var(--hero-focus-y);
  }

  /* Tall narrow screens (phones, portrait tablets): bias toward the
     waterline so the composition stays intentional while cropping sides. */
  @media (max-aspect-ratio: 3 / 4) {
    .hero {
      --hero-focus-x: 62%;
      --hero-focus-y: 38%;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: var(--z-overlay);
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(7, 26, 43, 0.62) 0%,
        rgba(7, 26, 43, 0.34) 42%,
        rgba(7, 26, 43, 0.08) 78%
      ),
      linear-gradient(
        to top,
        rgba(7, 26, 43, 0.78) 0%,
        rgba(7, 26, 43, 0) 30%
      );
  }

  .hero-main {
    position: relative;
    z-index: var(--z-content);
    flex: 1;
    display: grid;
    align-items: center;
    width: 100%;
    padding-top: calc(4rem + clamp(1rem, 4vh, 2.5rem));
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 2rem + 4vh, 3.5rem);
    align-items: center;
  }

  /* Two-column split once the form panel has room to breathe */
  @media (min-width: 64rem) {
    .hero-main {
      padding-top: calc(5rem + clamp(1rem, 4vh, 2.5rem));
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(22rem, 0.75fr);
      gap: clamp(2rem, 5vw, 6rem);
    }
  }

  /* Compact viewports (short laptops): tighten vertical rhythm so the
     first viewport stays composed without clipping. */
  @media (min-width: 64rem) and (max-height: 920px) {
    .hero-main {
      padding-top: calc(4.5rem + 1rem);
      padding-bottom: 1.25rem;
    }
  }
</style>
