---
/**
 * QuoteForm.astro — primary conversion element in the hero.
 * Restrained glassmorphism panel. Native HTML validation only (no JS).
 * Posts to /api/quote (Vercel serverless route lands in a later phase).
 */
import Button from "../ui/Button.astro";
import GoldLine from "../ui/GoldLine.astro";
import Icon from "../ui/Icon.astro";

const projectTypes = [
  "Dock Installation",
  "Boat Lift",
  "Seawall",
  "Patio",
  "Beach",
  "Retaining Wall",
  "Landscaping",
  "Service / Repair",
  "Other",
];
---

<div class="quote-form">
  <div class="quote-heading">
    <p class="eyebrow">Free Estimate</p>
    <h2 class="quote-title">Tell us about your project</h2>
    <GoldLine />
  </div>

  <form action="/api/quote" method="post" class="quote-fields">
    <p class="hp-field" aria-hidden="true">
      <label>
        Company
        <input type="text" name="company" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="form-grid">
      <div class="field">
        <label for="quote-name">Full Name</label>
        <input
          id="quote-name"
          type="text"
          name="name"
          placeholder="John Smith"
          autocomplete="name"
          required
        />
      </div>

      <div class="field">
        <label for="quote-email">Email</label>
        <input
          id="quote-email"
          type="email"
          name="email"
          placeholder="you@example.com"
          autocomplete="email"
          required
        />
      </div>

      <div class="field">
        <label for="quote-phone">Phone</label>
        <input
          id="quote-phone"
          type="tel"
          name="phone"
          placeholder="(517) 000-0000"
          autocomplete="tel"
          required
        />
      </div>

      <div class="field">
        <label for="quote-location">Project Location</label>
        <input
          id="quote-location"
          type="text"
          name="location"
          placeholder="Lake name or city"
          autocomplete="address-level2"
          required
        />
      </div>

      <div class="field field-wide">
        <label for="quote-type">Project Type</label>
        <div class="select-wrap">
          <select id="quote-type" name="project_type" required>
            <option value="" selected disabled>Select a service…</option>
            {projectTypes.map((type) => <option value={type}>{type}</option>)}
          </select>
          <Icon
            name="chevron-down"
            size={16}
            class="select-icon"
          />
        </div>
      </div>

      <div class="field field-wide">
        <label for="quote-message">Message</label>
        <textarea
          id="quote-message"
          name="message"
          rows="3"
          placeholder="Tell us about your waterfront…"
        />
      </div>
    </div>

    <Button
      type="submit"
      variant="gold"
      size="md"
      class="w-full"
      iconPosition="right"
    >
      Request My Free Quote
    </Button>

    <p class="quote-privacy">
      We respect your privacy — no spam, no obligation. Your details stay with
      us.
    </p>
  </form>
</div>

<style>
  .quote-form {
    width: 100%;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.38);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-panel);
    padding: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .quote-form {
      background: rgba(7, 26, 43, 0.82);
    }
  }

  .quote-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
    margin-bottom: clamp(1.25rem, 1rem + 0.75vw, 1.75rem);
  }

  .quote-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.1;
    color: var(--color-text-on-image);
  }

  .quote-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: 0;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .field label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: var(--radius-sm);
    padding: 0.625rem 0.875rem;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-white);
    transition:
      border-color var(--duration-fast) var(--ease-premium),
      background-color var(--duration-fast) var(--ease-premium);
  }

  .field textarea {
    resize: vertical;
    min-height: 4.5rem;
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: rgba(255, 255, 255, 0.45);
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--color-gold-400);
    background: rgba(255, 255, 255, 0.16);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap select {
    appearance: none;
    -webkit-appearance: none;
    padding-inline-end: 2.5rem;
    cursor: pointer;
  }

  .select-wrap select option {
    color: var(--color-navy-950);
    background: var(--color-white);
  }

  .select-icon {
    position: absolute;
    top: 50%;
    right: 0.875rem;
    translate: 0 -50%;
    pointer-events: none;
    color: rgba(255, 255, 255, 0.7);
  }

  .quote-privacy {
    margin: 0;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.55);
    text-align: center;
  }

  /* Two-column field grid once the panel has real width */
  @media (min-width: 40rem) {
    .form-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .field-wide {
      grid-column: 1 / -1;
    }
  }

  /* Short laptop viewports (e.g. 1280×800): keep the panel inside the
     first viewport without clipping content. */
  @media (min-width: 64rem) and (max-height: 920px) {
    .quote-form {
      padding: 1.25rem 1.5rem;
    }
    .quote-heading {
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .quote-fields,
    .form-grid {
      gap: 0.75rem;
    }
    .field input,
    .field select,
    .field textarea {
      padding: 0.5rem 0.75rem;
    }
    .field textarea {
      min-height: 3.25rem;
    }
  }
</style>
