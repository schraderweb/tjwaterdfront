---
/**
 * HeroServicesBar.astro — four dock services along the hero's bottom edge.
 * Desktop: 4 equal columns with subtle dividers.
 * Mobile: horizontally scrollable with snap — never four squeezed columns.
 */
import Icon from "../ui/Icon.astro";
import { heroServices } from "../../data/site";
---

<div class="service-bar" role="navigation" aria-label="Dock services">
  <div class="site-container">
    <ul class="service-list">
      {
        heroServices.map((service) => (
          <li class="service-item">
            <a href={service.href} class="service-link">
              <span class="service-icon" aria-hidden="true">
                <Icon name={service.icon} size={54} strokeWidth={1.35} />
              </span>
              <span class="service-text">
                <span class="service-title">{service.title}</span>
                <span class="service-desc">{service.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .service-bar {
    position: relative;
    z-index: var(--z-content);
    background: rgba(7, 26, 43, 0.78);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.26);
  }

  .service-bar > .site-container {
    width: calc(100% - 2 * var(--container-gutter));
    max-width: var(--container-xl);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .service-bar {
      background: rgba(7, 26, 43, 0.95);
    }
  }

  .service-list {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-list::-webkit-scrollbar {
    display: none;
  }

  .service-item {
    flex: 1 0 auto;
    min-width: min(17rem, 80vw);
    scroll-snap-align: start;
    border-inline-start: 1px solid rgba(255, 255, 255, 0.34);
  }

  .service-item:first-child {
    border-inline-start: 0;
  }

  .service-link {
    display: flex;
    align-items: flex-start;
    gap: clamp(1rem, 1.5vw, 1.5rem);
    height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 1.625rem)
      clamp(1rem, 0.75rem + 1.25vw, 1.75rem);
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-premium);
  }

  .service-link:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .service-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    color: var(--color-white);
    transition: color var(--duration-base) var(--ease-premium);
  }

  .service-link:hover .service-icon {
    color: var(--color-gold-200);
  }

  .service-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .service-title {
    font-size: clamp(1rem, 0.85rem + 0.35vw, 1.25rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
    color: var(--color-white);
  }

  .service-desc {
    max-width: 30ch;
    font-size: clamp(0.75rem, 0.68rem + 0.2vw, 0.9rem);
    line-height: 1.45;
    color: rgba(246, 241, 231, 0.86);
  }

  /* Desktop: four true columns */
  @media (min-width: 64rem) {
    .service-list {
      overflow-x: visible;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
