---
/**
 * HeroContent.astro — eyebrow, editorial serif H1, supporting copy, actions.
 * Fluid clamp() typography; gold is used as jewelry (one highlighted line).
 */
import GoldLine from "../ui/GoldLine.astro";
import HeroActions from "./HeroActions.astro";
---

<div class="hero-content">
  <p class="eyebrow hero-eyebrow">Built for Michigan. Built to last.</p>

  <h1 class="hero-title">
    <span>Premium</span>
    <span>Waterfront</span>
    <span>Solutions.</span>
    <span class="hero-title-accent">Built Around You.</span>
  </h1>

  <GoldLine class="hero-rule" />

  <p class="hero-copy">
    From docks and seawalls to patios and beaches, we design and build lasting
    waterfront spaces that elevate your lifestyle.
  </p>

  <HeroActions />
</div>

<style>
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.35rem);
    max-width: 60rem;
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--color-gold-700);
    text-shadow: 0 1px 8px rgba(255, 255, 255, 0.3);
  }

  .hero-title {
    margin: 0;
    max-width: 58rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.5rem, 4.75vw, 6.75rem);
    line-height: 0.91;
    letter-spacing: -0.045em;
    color: var(--color-navy-950);
    text-wrap: balance;
  }

  .hero-title span {
    display: block;
  }

  .hero-title-accent {
    color: var(--color-gold-600);
  }

  .hero-rule {
    margin-top: clamp(0.15rem, 0.1rem + 0.25vw, 0.35rem);
  }

  .hero-copy {
    margin: 0;
    max-width: 38ch;
    font-size: clamp(0.95rem, 0.85rem + 0.3vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-navy-900);
  }

  /* Short laptop viewports (e.g. 1280×800): tighten the left column so
     the first viewport stays composed. */
  @media (min-width: 64rem) and (max-height: 920px) {
    .hero-content {
      gap: 0.85rem;
    }
    .hero-title {
      font-size: clamp(3.1rem, 4.7vw, 5.5rem);
    }
  }

  @media (min-width: 64rem) and (min-height: 921px) {
    .hero-content {
      transform: translateY(clamp(0rem, 1.8vh, 1.1rem));
    }
  }

  @media (max-width: 63.999rem) {
    .hero-title {
      max-width: 36rem;
    }
  }
</style>
