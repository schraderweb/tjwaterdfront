---
import Icon from "../ui/Icon.astro";
import GoldLine from "../ui/GoldLine.astro";
---

<header class="services-header">
  <div class="eyebrow">
    <Icon name="anchor" size={16} strokeWidth={2} class="eyebrow-icon" />
    <span>OUR SERVICES</span>
  </div>
  
  <h2 class="section-title">Popular Services</h2>
  
  <div class="decorative-divider" aria-hidden="true">
    <div class="divider-line divider-line-left"></div>
    <div class="divider-segment divider-gold"></div>
    <div class="divider-segment divider-navy"></div>
    <div class="divider-line divider-line-right"></div>
  </div>
  
  <p class="intro-description">
    From dock repairs to complete waterfront enhancements,<br class="hidden sm:block" />
    we provide expert solutions to keep your waterfront beautiful and functional.
  </p>
</header>

<style>
  .services-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--color-gold-600, #b98232);
    font-family: var(--font-body, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .eyebrow-icon {
    color: var(--color-gold-600, #b98232);
  }

  .section-title {
    margin: 0;
    color: var(--color-navy-950, #071a2d);
    font-family: var(--font-display, serif);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin-bottom: 1.5rem;
  }

  .decorative-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    width: 100%;
    max-width: 240px;
    margin-bottom: 1.75rem;
  }

  .divider-line {
    flex: 1;
    height: 1px;
    background-color: rgba(7, 26, 45, 0.1);
  }

  .divider-segment {
    height: 3px;
    width: 24px;
  }

  .divider-gold {
    background-color: var(--color-gold-500, #d4a373);
  }

  .divider-navy {
    background-color: var(--color-navy-800, #102b43);
  }

  .intro-description {
    margin: 0;
    color: var(--color-navy-800, #102b43);
    font-family: var(--font-body, sans-serif);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.6;
    max-width: 48rem;
  }

  @media (max-width: 640px) {
    .intro-description br {
      display: none;
    }
  }
</style>
