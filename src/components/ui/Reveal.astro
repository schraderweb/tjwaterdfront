---
/**
 * Reveal.astro — subtle scroll reveal wrapper (opacity + translateY(24px)).
 * Content is visible by default; only hidden when JS is present (html.js)
 * and the element is below the fold. IntersectionObserver in reveal.js.
 * Do NOT wrap above-the-fold hero content in Reveal.
 */
interface Props {
  delay?: number;
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { delay = 0, as: Tag = "div", class: className } = Astro.props;
---

<Tag
  data-reveal
  class:list={["reveal", className]}
  style={delay > 0 ? `--reveal-delay: ${delay}ms` : undefined}
>
  <slot />
</Tag>
