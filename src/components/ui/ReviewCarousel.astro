---
import ReviewCard from "./ReviewCard.astro";
import Icon from "./Icon.astro";
import type { Review } from "../../data/reviews";

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;

// We duplicate the reviews 3 times to allow seamless infinite scrolling
const displayReviews = [...reviews, ...reviews, ...reviews];
---

<div class="carousel-wrapper" data-review-count={reviews.length}>
  <button class="carousel-control prev" aria-label="Previous reviews" id="btn-prev">
    <Icon name="arrow-right" size={24} class="flip-icon" />
  </button>
  
  <div class="carousel-viewport" id="carousel-viewport">
    <div class="carousel-track">
      {displayReviews.map((review, i) => (
        <div class="carousel-slide" data-index={i % reviews.length}>
          <ReviewCard {...review} />
        </div>
      ))}
    </div>
  </div>

  <button class="carousel-control next" aria-label="Next reviews" id="btn-next">
    <Icon name="arrow-right" size={24} />
  </button>
  
  <div class="carousel-pagination">
    {reviews.map((_, i) => (
      <button 
        class={`dot ${i === 0 ? "active" : ""}`} 
        aria-label={`Go to slide ${i + 1}`}
        data-index={i}
      ></button>
    ))}
  </div>
</div>

<style>
  .carousel-wrapper {
    position: relative;
    width: 100%;
    margin-inline: auto;
    max-width: 1400px;
    padding-bottom: 2rem;
  }

  .carousel-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-block: 1rem 2rem; 
    /* Add padding to each side so cards don't touch edges */
    padding-inline: 5vw;
  }

  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  .carousel-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
  }

  .carousel-slide {
    flex: 0 0 calc(280px);
    scroll-snap-align: center; /* Snap to center so padding is visible on both sides */
  }

  @media (min-width: 600px) {
    .carousel-slide { flex: 0 0 320px; }
  }
  
  @media (min-width: 1024px) {
    .carousel-slide { flex: 0 0 350px; }
    .carousel-viewport {
      padding-inline: 4rem; /* Desktop side padding */
    }
  }

  @media (min-width: 64rem) {
    .carousel-wrapper {
      padding-bottom: 0;
    }

    .carousel-viewport {
      overflow: visible;
      padding: 0;
    }

    .carousel-track {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: clamp(0.5rem, 1.2vw, 1rem);
      width: 100%;
    }

    .carousel-slide {
      display: block;
      min-width: 0;
    }

    .carousel-slide:nth-child(n + 7) {
      display: none;
    }

    .carousel-control,
    .carousel-pagination {
      display: none;
    }
  }

  /* Controls */
  .carousel-control {
    display: none;
    position: absolute;
    top: calc(50% - 2rem);
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1.5px solid var(--color-gold-400);
    background: transparent;
    color: var(--color-gold-600);
    cursor: pointer;
    z-index: 10;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .carousel-control.prev {
    left: 0;
  }
  .carousel-control.next {
    right: 0;
  }

  .flip-icon {
    transform: rotate(180deg);
  }

  .carousel-control:hover {
    background: var(--color-gold-600);
    border-color: var(--color-gold-600);
    color: white;
  }

  @media (min-width: 1024px) {
    .carousel-control {
      display: flex;
    }
    .carousel-control.prev { left: -1rem; }
    .carousel-control.next { right: -1rem; }
  }

  /* Pagination */
  .carousel-pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cream-300);
    border: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
    padding: 0;
  }

  .dot.active {
    background: var(--color-gold-600);
  }
</style>

<script>
  const wrappers = document.querySelectorAll('.carousel-wrapper');
  
  wrappers.forEach((wrapper) => {
    const viewport = wrapper.querySelector('#carousel-viewport') as HTMLElement;
    const track = wrapper.querySelector('.carousel-track') as HTMLElement;
    const btnPrev = wrapper.querySelector('#btn-prev');
    const btnNext = wrapper.querySelector('#btn-next');
    const dots = wrapper.querySelectorAll('.dot');
    const originalCount = parseInt(wrapper.getAttribute('data-review-count') || '0');
    
    if (!viewport || !track || originalCount === 0) return;

    // Helper to get true item width
    const getSlideWidth = () => {
      const slide = track.firstElementChild as HTMLElement;
      return slide ? slide.offsetWidth + 24 : 324; // 24px is the gap
    };

    // Auto-scroll configuration
    let autoScrollInterval: ReturnType<typeof setInterval>;
    const AUTO_SCROLL_DELAY = 4000; // interval between scrolls
    
    // Start somewhere in the middle set so we can scroll left or right immediately
    // Wait a tick for layout to establish
    setTimeout(() => {
       const initialScroll = getSlideWidth() * originalCount;
       viewport.scrollTo({ left: initialScroll, behavior: 'auto' });
       updateDots();
       startAutoScroll();
    }, 100);

    const startAutoScroll = () => {
      clearInterval(autoScrollInterval);
      autoScrollInterval = setInterval(() => {
        scrollNext();
      }, AUTO_SCROLL_DELAY);
    };

    const stopAutoScroll = () => {
      clearInterval(autoScrollInterval);
    };

    const scrollNext = () => {
      viewport.scrollBy({ left: getSlideWidth(), behavior: 'smooth' });
    };

    const scrollPrev = () => {
      viewport.scrollBy({ left: -getSlideWidth(), behavior: 'smooth' });
    };

    // Infinite loop trick: if we get too close to the edges, jump back to the middle set quietly
    const handleInfiniteScroll = () => {
      const sw = getSlideWidth();
      const currentScroll = viewport.scrollLeft;
      
      // If we scroll past the second set, jump back to first set
      if (currentScroll >= sw * originalCount * 2) {
        viewport.scrollTo({ left: currentScroll - (sw * originalCount), behavior: 'auto' });
      }
      // If we scroll into the first set too far left, jump forward to second set
      else if (currentScroll <= sw * (originalCount - 1)) {
        viewport.scrollTo({ left: currentScroll + (sw * originalCount), behavior: 'auto' });
      }
    };

    let scrollTimeout: ReturnType<typeof setTimeout>;
    viewport.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        handleInfiniteScroll();
        updateDots();
      }, 150); // wait for snap to finish
    });

    const updateDots = () => {
      const sw = getSlideWidth();
      // Calculate which physical slide is near the center of the viewport
      const centerScroll = viewport.scrollLeft + (viewport.clientWidth / 2);
      const activePhysicalIndex = Math.floor(centerScroll / sw);
      
      // Map it back to the original index
      const activeOriginalIndex = activePhysicalIndex % originalCount;

      dots.forEach((dot, i) => {
        if (i === activeOriginalIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    };

    // Manual controls
    if (btnNext) {
      btnNext.addEventListener('click', () => {
        stopAutoScroll();
        scrollNext();
        startAutoScroll(); // restart timer
      });
    }
    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        stopAutoScroll();
        scrollPrev();
        startAutoScroll();
      });
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        stopAutoScroll();
        // Calculate current physical offset set
        const sw = getSlideWidth();
        const currentSet = Math.floor(viewport.scrollLeft / (sw * originalCount));
        const targetPhysicalIndex = (currentSet * originalCount) + i;
        
        viewport.scrollTo({ left: targetPhysicalIndex * sw, behavior: 'smooth' });
        startAutoScroll();
      });
    });

    // Pause on hover/touch
    viewport.addEventListener('mouseenter', stopAutoScroll);
    viewport.addEventListener('mouseleave', startAutoScroll);
    viewport.addEventListener('touchstart', stopAutoScroll, { passive: true });
    viewport.addEventListener('touchend', startAutoScroll, { passive: true });
  });
</script>
