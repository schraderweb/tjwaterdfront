---
import ReviewCard from "./ReviewCard.astro";
import Icon from "./Icon.astro";
import type { Review } from "../../data/reviews";

interface Props {
  reviews: Review[];
}

const { reviews } = Astro.props;
---

<div class="carousel-wrapper" data-review-count={reviews.length}>
  <div class="carousel-frame">
    <button type="button" class="carousel-control prev" aria-label="Previous reviews" data-carousel-action="prev">
    <Icon name="arrow-right" size={24} class="flip-icon" />
    </button>

    <div
      class="carousel-viewport"
      role="region"
      aria-roledescription="carousel"
      aria-label="Customer reviews"
      tabindex="0"
    >
      <div class="carousel-track">
        {reviews.map((review, i) => (
          <div
            class="carousel-slide"
            data-index={i}
            role="group"
            aria-roledescription="slide"
            aria-label={`Review ${i + 1} of ${reviews.length}`}
          >
            <ReviewCard {...review} />
          </div>
        ))}
      </div>
    </div>

    <button type="button" class="carousel-control next" aria-label="Next reviews" data-carousel-action="next">
      <Icon name="arrow-right" size={24} />
    </button>
  </div>

  <div class="carousel-pagination" aria-label="Review pages">
    {reviews.map((_, i) => (
      <button
        type="button"
        class={`dot ${i === 0 ? "active" : ""}`}
        aria-label={`Go to review page ${i + 1}`}
        aria-current={i === 0 ? "true" : undefined}
        data-index={i}
      ></button>
    ))}
  </div>
</div>

<style>
  .carousel-wrapper {
    --review-gap: clamp(1rem, 1.4vw, 1.5rem);
    position: relative;
    width: 100%;
    margin-inline: auto;
  }

  .carousel-frame {
    position: relative;
  }

  .carousel-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    overscroll-behavior-x: contain;
    padding: 0.25rem 0.5rem 0.75rem;
    scroll-padding-inline: 0.5rem;
  }

  .carousel-viewport::-webkit-scrollbar {
    display: none;
  }

  .carousel-track {
    align-items: stretch;
    display: flex;
    gap: var(--review-gap);
    width: 100%;
  }

  .carousel-slide {
    display: flex;
    flex: 0 0 calc((100% - var(--review-gap)) / 1.12);
    min-width: 0;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @media (min-width: 40rem) {
    .carousel-viewport {
      padding-inline: 0;
      scroll-padding-inline: 0;
    }

    .carousel-slide {
      flex-basis: calc((100% - var(--review-gap)) / 2);
    }
  }

  @media (min-width: 64rem) {
    .carousel-slide {
      flex-basis: calc((100% - var(--review-gap) - var(--review-gap)) / 3);
    }
  }

  @media (min-width: 80rem) {
    .carousel-slide {
      flex-basis: calc((100% - var(--review-gap) - var(--review-gap) - var(--review-gap)) / 4);
    }
  }

  @media (min-width: 120rem) {
    .carousel-slide {
      flex-basis: calc((100% - var(--review-gap) - var(--review-gap) - var(--review-gap) - var(--review-gap)) / 5);
    }
  }

  /* Controls remain outside the cards, as in the reference interaction. */
  .carousel-control {
    display: none;
    position: absolute;
    top: 50%;
    z-index: var(--z-content);
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-gold-400);
    border-radius: 50%;
    background: var(--color-cream-50);
    color: var(--color-gold-700);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      background-color var(--duration-fast) var(--ease-premium),
      border-color var(--duration-fast) var(--ease-premium),
      color var(--duration-fast) var(--ease-premium);
  }

  .carousel-control.prev {
    left: calc(0rem - var(--container-gutter));
  }

  .carousel-control.next {
    right: calc(0rem - var(--container-gutter));
  }

  .flip-icon {
    transform: rotate(180deg);
  }

  .carousel-control:hover {
    border-color: var(--color-gold-500);
    background: var(--color-gold-500);
    color: var(--color-white);
  }

  .carousel-control:focus-visible,
  .dot:focus-visible {
    outline: 2px solid var(--color-gold-500);
    outline-offset: 3px;
  }

  @media (min-width: 40rem) {
    .carousel-control {
      display: flex;
    }

    .carousel-control.prev {
      left: calc(0rem - var(--container-gutter));
    }

    .carousel-control.next {
      right: calc(0rem - var(--container-gutter));
    }
  }

  .carousel-wrapper.is-static .carousel-control,
  .carousel-wrapper.is-static .carousel-pagination {
    display: none;
  }

  .carousel-pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    min-height: 0.5rem;
    margin-top: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 0.5rem;
    border-radius: 50%;
    background: var(--color-cream-300);
    border: none;
    cursor: pointer;
    padding: 0;
    transition:
      background-color var(--duration-fast) var(--ease-premium),
      transform var(--duration-fast) var(--ease-premium);
  }

  .dot.active {
    background: var(--color-gold-500);
    transform: scale(1.25);
  }
</style>

<script>
  const wrappers = document.querySelectorAll<HTMLElement>('.carousel-wrapper');

  wrappers.forEach((wrapper) => {
    const viewport = wrapper.querySelector<HTMLElement>('.carousel-viewport');
    const track = wrapper.querySelector<HTMLElement>('.carousel-track');
    const slides = Array.from(wrapper.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots = Array.from(wrapper.querySelectorAll<HTMLButtonElement>('.dot'));
    const btnPrev = wrapper.querySelector<HTMLButtonElement>('[data-carousel-action="prev"]');
    const btnNext = wrapper.querySelector<HTMLButtonElement>('[data-carousel-action="next"]');
    const originalCount = Number(wrapper.dataset.reviewCount || 0);

    if (!viewport || !track || !slides.length || !originalCount) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const AUTO_SCROLL_DELAY = 3500;
    let current = 0;
    let autoScrollInterval: number | undefined;
    let scrollTimeout: number | undefined;
    let restartTimeout: number | undefined;
    let resizeFrame: number | undefined;

    const getVisibleCount = () => {
      if (window.matchMedia('(min-width: 120rem)').matches) return 5;
      if (window.matchMedia('(min-width: 80rem)').matches) return 4;
      if (window.matchMedia('(min-width: 64rem)').matches) return 3;
      if (window.matchMedia('(min-width: 40rem)').matches) return 2;
      return 1;
    };

    const getPageCount = () => Math.max(1, originalCount - getVisibleCount() + 1);

    const getStep = () => {
      const slide = slides[0];
      if (!slide) return viewport.clientWidth;

      const gap = parseFloat(window.getComputedStyle(track).columnGap || '0') || 0;
      return slide.getBoundingClientRect().width + gap;
    };

    const updateDots = () => {
      const pageCount = getPageCount();
      current = Math.min(current, pageCount - 1);
      wrapper.classList.toggle('is-static', pageCount === 1);

      dots.forEach((dot, index) => {
        const isActive = index === current;
        dot.hidden = index >= pageCount;
        dot.classList.toggle('active', isActive);
        dot.setAttribute('aria-label', `Go to review page ${index + 1} of ${pageCount}`);

        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    };

    const goTo = (index: number, behavior: ScrollBehavior = 'smooth') => {
      const pageCount = getPageCount();
      current = ((index % pageCount) + pageCount) % pageCount;
      viewport.scrollTo({
        left: current * getStep(),
        behavior: reducedMotion.matches ? 'auto' : behavior,
      });
      updateDots();
    };

    const updateFromScroll = () => {
      const step = getStep();
      const pageCount = getPageCount();
      if (!step) return;

      current = Math.max(0, Math.min(pageCount - 1, Math.round(viewport.scrollLeft / step)));
      updateDots();
    };

    const stopAutoScroll = () => {
      if (autoScrollInterval !== undefined) {
        window.clearInterval(autoScrollInterval);
        autoScrollInterval = undefined;
      }
    };

    const startAutoScroll = () => {
      stopAutoScroll();
      if (reducedMotion.matches || document.visibilityState !== 'visible' || getPageCount() === 1) return;

      autoScrollInterval = window.setInterval(() => goTo(current + 1), AUTO_SCROLL_DELAY);
    };

    const restartAutoScroll = () => {
      if (restartTimeout !== undefined) window.clearTimeout(restartTimeout);
      restartTimeout = window.setTimeout(startAutoScroll, 250);
    };

    const handleResize = () => {
      if (resizeFrame !== undefined) window.cancelAnimationFrame(resizeFrame);
      resizeFrame = window.requestAnimationFrame(() => {
        current = Math.min(current, getPageCount() - 1);
        updateDots();
        goTo(current, 'auto');
        startAutoScroll();
      });
    };

    btnPrev?.addEventListener('click', () => {
      stopAutoScroll();
      goTo(current - 1);
      restartAutoScroll();
    });

    btnNext?.addEventListener('click', () => {
      stopAutoScroll();
      goTo(current + 1);
      restartAutoScroll();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        stopAutoScroll();
        goTo(index);
        restartAutoScroll();
      });
    });

    viewport.addEventListener('scroll', () => {
      if (scrollTimeout !== undefined) window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(updateFromScroll, 80);
    }, { passive: true });

    wrapper.addEventListener('mouseenter', stopAutoScroll);
    wrapper.addEventListener('mouseleave', startAutoScroll);
    wrapper.addEventListener('focusin', stopAutoScroll);
    wrapper.addEventListener('focusout', () => {
      if (!wrapper.contains(document.activeElement)) restartAutoScroll();
    });
    viewport.addEventListener('touchstart', stopAutoScroll, { passive: true });
    viewport.addEventListener('touchend', restartAutoScroll, { passive: true });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') startAutoScroll();
      else stopAutoScroll();
    });
    window.addEventListener('resize', handleResize, { passive: true });
    reducedMotion.addEventListener?.('change', () => {
      if (reducedMotion.matches) stopAutoScroll();
      else startAutoScroll();
    });

    updateDots();
    goTo(0, 'auto');
    startAutoScroll();
  });
</script>
