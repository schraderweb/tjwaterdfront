---
import Icon from "./Icon.astro";

interface Props {
  name: string;
  timeAgo: string;
  content: string;
  stars?: number;
}

const { name, timeAgo, content, stars = 5 } = Astro.props;
const starArray = Array(stars).fill(0);
---

<article class="review-card">
  <div class="stars" role="img" aria-label={`Rated ${stars} out of 5 stars`}>
    {starArray.map(() => (
      <Icon name="star" class="star-icon" size={18} strokeWidth={1.5} />
    ))}
  </div>
  <h3 class="reviewer-name">{name}</h3>
  <span class="time-ago">{timeAgo}</span>
  <div class="meta-divider" aria-hidden="true"></div>
  <p class="review-content">"{content}"</p>
</article>

<style>
  .review-card {
    width: 100%;
    min-height: 16rem;
    padding: var(--space-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    height: 100%;
    border: var(--border-dark);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
  }

  .stars {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 0.9rem;
    color: var(--color-gold-500);
  }

  :global(.star-icon) {
    fill: currentColor;
    /* Optional: If Icon.astro overrides fill, we ensure it applies */
  }

  .reviewer-name {
    font-family: var(--font-display);
    color: var(--color-navy-950);
    font-size: clamp(1.125rem, 1rem + 0.25vw, 1.375rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 0 0 0.25rem;
  }

  .time-ago {
    color: var(--color-text-muted);
    font-size: var(--text-tiny);
    line-height: 1.4;
    margin-bottom: 1rem;
  }

  .meta-divider {
    width: 32px;
    height: 1px;
    background-color: var(--color-gold-500);
    margin: 0 auto 1.15rem;
  }

  .review-content {
    max-width: 38ch;
    margin: 0;
    color: var(--color-text-primary);
    font-size: var(--text-small);
    line-height: 1.6;
  }
</style>
