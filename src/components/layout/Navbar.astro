---
/**
 * Navbar.astro — fixed navigation.
 * Transparent over the hero → navy glass after scrolling (12px threshold).
 * Desktop: logo | links (Services dropdown) | phone | CTA
 * Mobile (<1024px): logo | menu button | full panel
 */
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import { navLinks, site } from "../../data/site";
---

<a href="#main" class="skip-link">Skip to content</a>

<header data-navbar class="navbar">
  <div class="site-container navbar-inner">
    <a href="/" class="logo" aria-label="T&J Waterfront Services — Home">
      <span class="logo-mark">T&J</span>
      <span class="logo-sub">Waterfront Services</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li class:list={["nav-item", link.children && "has-dropdown"]}>
              {
                link.children ? (
                  <>
                    <a href={link.href} class="nav-link" aria-haspopup="true">
                      {link.label}
                      <Icon
                        name="chevron-down"
                        size={12}
                        class="nav-chevron"
                      />
                    </a>
                    <ul class="dropdown">
                      {link.children.map((child) => (
                        <li>
                          <a href={child.href} class="dropdown-link">
                            {child.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <a
                    href={link.href}
                    class:list={[
                      "nav-link",
                      link.href === "/" && "is-active",
                    ]}
                    {...(link.href === "/" ? { "aria-current": "page" } : {})}
                  >
                    {link.label}
                  </a>
                )
              }
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-actions">
      <a href={site.phoneHref} class="nav-phone">
        <Icon name="phone" size={15} />
        <span>{site.phone}</span>
      </a>
      <Button href="/contact" variant="gold" size="sm" class="nav-cta">
        Start Your Project
      </Button>
      <button
        type="button"
        data-menu-button
        class="menu-button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={24} class="icon-menu" />
        <Icon name="close" size={24} class="icon-close" />
      </button>
    </div>
  </div>

  <div data-menu-panel id="mobile-menu" class="mobile-menu">
    <nav aria-label="Mobile">
      <ul class="mobile-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-link">
              {link.label}
            </a>
            {link.children && (
              <ul class="mobile-sublist">
                {link.children.map((child) => (
                  <li>
                    <a href={child.href} class="mobile-sublink">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="mobile-actions">
      <a href={site.phoneHref} class="mobile-phone">
        <Icon name="phone" size={16} />
        {site.phone}
      </a>
      <Button href="/contact" variant="gold" size="md" class="w-full">
        Start Your Project
      </Button>
      <p class="mobile-hours">Open daily 7:00 AM – 7:00 PM · Howell, MI</p>
    </div>
  </div>
</header>

<script src="../../scripts/navbar.js"></script>

<style>
  .skip-link {
    position: fixed;
    top: -3rem;
    left: 1rem;
    z-index: calc(var(--z-modal));
    padding: 0.5rem 1rem;
    background: var(--color-gold-500);
    color: var(--color-navy-950);
    font-weight: 700;
    font-size: var(--text-small);
    border-radius: var(--radius-sm);
    transition: top var(--duration-fast) var(--ease-premium);
  }
  .skip-link:focus-visible {
    top: 0.75rem;
  }

  .navbar {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: var(--z-nav);
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) var(--ease-premium),
      border-color var(--duration-base) var(--ease-premium),
      box-shadow var(--duration-base) var(--ease-premium);
  }

  .navbar.is-scrolled {
    background: rgba(7, 26, 43, 0.82);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom-color: var(--color-border-light);
    box-shadow: 0 8px 30px -18px rgba(7, 26, 43, 0.5);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .navbar.is-scrolled {
      background: rgba(7, 26, 43, 0.97);
    }
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4rem;
  }

  .logo {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    line-height: 1;
    text-decoration: none;
  }

  .logo-mark {
    font-family: var(--font-display);
    font-size: 1.875rem;
    color: var(--color-gold-500);
    letter-spacing: 0.01em;
  }

  .logo-sub {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--color-white);
  }

  .nav-desktop {
    display: none;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding-block: 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: var(--tracking-nav);
    text-transform: uppercase;
    color: var(--color-white);
    text-decoration: none;
    position: relative;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .nav-link::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0.25rem;
    height: 1px;
    background: var(--color-gold-500);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-premium);
  }

  .nav-link:hover,
  .nav-item.has-dropdown:focus-within .nav-link {
    color: var(--color-gold-400);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    transform: scaleX(1);
  }

  .nav-chevron {
    transition: transform var(--duration-base) var(--ease-premium);
  }

  .has-dropdown:hover .nav-chevron,
  .has-dropdown:focus-within .nav-chevron {
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0.5rem;
    min-width: 15rem;
    padding: 0.5rem;
    margin: 0;
    list-style: none;
    background: rgba(7, 26, 43, 0.95);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-panel);
    opacity: 0;
    visibility: hidden;
    transform: translateY(4px);
    transition:
      opacity var(--duration-base) var(--ease-premium),
      transform var(--duration-base) var(--ease-premium),
      visibility var(--duration-base) var(--ease-premium);
  }

  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    font-weight: 500;
    color: var(--color-text-on-dark);
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-premium),
      color var(--duration-fast) var(--ease-premium);
  }

  .dropdown-link:hover,
  .dropdown-link:focus-visible {
    background: rgba(255, 255, 255, 0.06);
    color: var(--color-gold-400);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-phone {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-small);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-white);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .nav-phone:hover {
    color: var(--color-gold-400);
  }

  .nav-phone svg {
    color: var(--color-gold-500);
  }

  .nav-cta {
    display: none;
  }

  .menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    background: var(--color-glass);
    color: var(--color-white);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-premium);
  }

  .menu-button:hover {
    background: var(--color-glass-strong);
  }

  .menu-button .icon-close {
    display: none;
  }

  .navbar.is-open .menu-button .icon-menu {
    display: none;
  }
  .navbar.is-open .menu-button .icon-close {
    display: block;
  }

  /* Mobile menu panel */
  .mobile-menu {
    position: fixed;
    inset: 0;
    top: 4rem;
    z-index: calc(var(--z-menu) - 1);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    background: rgba(7, 26, 43, 0.98);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    border-top: 1px solid var(--color-border-light);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity var(--duration-base) var(--ease-premium),
      transform var(--duration-base) var(--ease-premium),
      visibility var(--duration-base) var(--ease-premium);
  }

  .navbar.is-open .mobile-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .mobile-list {
    list-style: none;
    margin: 0;
    padding: 1.5rem var(--container-gutter) 2rem;
    display: flex;
    flex-direction: column;
  }

  .mobile-link {
    display: block;
    padding: 1rem 0.25rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-text-on-dark);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mobile-sublist {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0 0.5rem 1rem;
    display: flex;
    flex-direction: column;
  }

  .mobile-sublink {
    display: block;
    padding: 0.65rem 0.25rem;
    font-size: var(--text-body);
    color: rgba(246, 241, 231, 0.75);
    text-decoration: none;
  }

  .mobile-sublink:hover {
    color: var(--color-gold-400);
  }

  .mobile-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 var(--container-gutter) 2.5rem;
  }

  .mobile-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-gold-400);
    text-decoration: none;
  }

  .mobile-hours {
    margin: 0;
    font-size: var(--text-tiny);
    color: rgba(246, 241, 231, 0.55);
    text-align: center;
  }

  /* ── Desktop breakpoint: content-driven (logo + links + phone + CTA) ── */
  @media (min-width: 64rem) {
    .navbar-inner {
      height: 5rem;
    }
    .nav-desktop {
      display: block;
    }
    .nav-cta {
      display: inline-flex;
    }
    .menu-button {
      display: none;
    }
    .mobile-menu {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .nav-phone {
      display: inline-flex;
    }
  }
</style>
