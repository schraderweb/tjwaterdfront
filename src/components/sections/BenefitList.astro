---
import Icon from "../ui/Icon.astro";

interface Benefit {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  benefits: Benefit[];
}

const { benefits } = Astro.props;
---

<ul class="benefits-list">
  {benefits.map((benefit) => (
    <li class="benefit-item">
      <div class="icon-wrap">
        <Icon name={benefit.icon} size={20} strokeWidth={1.5} class="benefit-icon" />
      </div>
      <div>
        <h4>{benefit.title}</h4>
        <p>{benefit.description}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .benefits-list {
    display: grid;
    gap: 1.5rem;
    width: 100%;
    max-width: 34rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .benefit-item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1.25rem;
  }

  .icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-cream-200);
    border: 1px solid rgba(198, 146, 61, 0.2); /* faint gold border */
  }

  :global(.benefit-icon) { color: var(--color-gold-600); }

  .benefit-item h4 {
    margin: 0 0 0.35rem;
    color: var(--color-navy-950);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .benefit-item p {
    max-width: 34ch;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: 1.55;
  }
</style>
