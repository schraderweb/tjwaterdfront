---
import Button from "../ui/Button.astro";
import GoldLine from "../ui/GoldLine.astro";

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
}

const { eyebrow, title, description, href } = Astro.props;
---

<article class="featured-service-panel">
  <div class="panel-content">
    <p class="eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <GoldLine />
    <p class="panel-description">{description}</p>
    <Button
      href={href}
      variant="gold"
      size="md"
      ariaLabel="Read more about Starr Boat Lifts"
    >Read More <span class="sr-only">about Starr Boat Lifts</span></Button>
  </div>
</article>

<style>
  .featured-service-panel {
    display: flex;
    min-height: clamp(24rem, 38vw, 42rem);
    align-items: center;
    background: var(--color-navy-950);
    color: var(--color-text-on-dark);
    padding: clamp(2rem, 4vw, 5rem);
  }

  .panel-content {
    max-width: 30rem;
  }

  .panel-content .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-gold-400);
  }

  .panel-content h3 {
    margin: 0 0 1.5rem;
    color: var(--color-text-on-dark);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .panel-description {
    max-width: 34ch;
    margin: 1.5rem 0 2rem;
    color: rgba(246, 241, 231, 0.82);
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  @media (max-width: 47.999rem) {
    .featured-service-panel {
      min-height: 23rem;
    }
  }
</style>
