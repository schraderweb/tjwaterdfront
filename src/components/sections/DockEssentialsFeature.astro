---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import BenefitList from "./BenefitList.astro";
import type { ImageMetadata } from "astro";

interface Benefit {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
  benefits: Benefit[];
  href: string;
}

const { eyebrow, title, description, imageSrc, imageAlt, benefits, href } = Astro.props;
---

<article class="dock-essentials">
  <figure class="essentials-image-wrapper">
    <Image
      src={imageSrc}
      alt={imageAlt}
      widths={[480, 640, 800, 1200]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      quality={78}
      format="webp"
      loading="lazy"
      decoding="async"
      class="essentials-image"
    />
  </figure>

  <div class="essentials-content">
    <div class="essentials-main">
      <p class="eyebrow">{eyebrow}</p>
      <h3 class="dock-title">{title}</h3>
      <div class="water-divider"></div>
      <p class="essentials-description">{description}</p>
      <Button
        href={href}
        variant="ghost-dark"
        class="!border !border-gold-500 !text-gold-700 hover:!bg-gold-50 mt-2 text-xs tracking-wider"
        size="md"
        ariaLabel="Read more about dock accessories"
      >READ MORE <span class="sr-only">about dock accessories</span></Button>
    </div>

    <div class="benefits-column">
      <BenefitList benefits={benefits} />
    </div>
  </div>
</article>

<style>
  .dock-essentials {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-cream-100);
  }

  .essentials-image-wrapper {
    aspect-ratio: 4 / 3;
    min-height: 0;
    margin: 0;
    overflow: hidden;
  }

  .essentials-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .essentials-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    padding: clamp(2rem, 5vw, 5.5rem);
  }

  .essentials-content .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-navy-800);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: underline;
    text-decoration-color: var(--color-gold-400);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4rem;
  }

  .essentials-content .dock-title {
    max-width: 10ch;
    margin: 0 0 1.5rem;
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3.25rem); /* Scaled down to prevent overflow */
    font-weight: 400;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .water-divider {
    width: 4rem;
    height: 1px;
    background-color: var(--color-water-600);
    margin-bottom: 1.5rem;
  }

  .essentials-description {
    max-width: 32ch;
    margin: 1.5rem 0 2rem;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 0.9rem + 0.35vw, 1.25rem);
    font-weight: 400;
    line-height: 1.6;
  }

  .benefits-column {
    min-width: 0;
  }

  .benefits-column :global(.benefits-list) {
    margin: 0;
  }

  @media (min-width: 64rem) {
    .dock-essentials {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      height: clamp(30rem, 35vw, 40rem);
      min-height: 0;
    }

    .essentials-image-wrapper {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }

    .essentials-content {
      height: 100%;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: clamp(1.5rem, 2vw, 2.5rem);
      padding: clamp(2rem, 3vw, 4rem) clamp(2rem, 4vw, 4rem);
    }

    .benefits-column {
      padding-left: clamp(1.5rem, 3vw, 3rem);
      border-left: 1px solid var(--color-border-dark);
    }
  }
</style>
