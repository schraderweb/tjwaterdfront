---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import BenefitList from "./BenefitList.astro";
import type { ImageMetadata } from "astro";

interface Benefit {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  imageSrc: ImageMetadata;
  imageAlt: string;
  benefits: Benefit[];
  href: string;
}

const { eyebrow, title, description, imageSrc, imageAlt, benefits, href } = Astro.props;
---

<article class="dock-essentials">
  <figure class="essentials-image-wrapper">
    <Image
      src={imageSrc}
      alt={imageAlt}
      widths={[480, 640, 800, 1200]}
      sizes="(min-width: 64rem) 50vw, 100vw"
      quality={78}
      format="webp"
      loading="lazy"
      decoding="async"
      class="essentials-image"
    />
  </figure>

  <div class="essentials-content">
    <p class="eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <p class="essentials-description">{description}</p>
    <BenefitList benefits={benefits} />
    <Button
      href={href}
      variant="navy"
      size="md"
      ariaLabel="Read more about dock accessories"
    >Read More <span class="sr-only">about dock accessories</span></Button>
  </div>
</article>

<style>
  .dock-essentials {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-cream-100);
  }

  .essentials-image-wrapper {
    aspect-ratio: 4 / 3;
    min-height: 0;
    margin: 0;
    overflow: hidden;
  }

  .essentials-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .essentials-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(2rem, 5vw, 5.5rem);
  }

  .essentials-content .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-navy-800);
    text-decoration: underline;
    text-decoration-color: var(--color-gold-600);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3rem;
  }

  .essentials-content h3 {
    margin: 0;
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .essentials-description {
    max-width: 34ch;
    margin: 1.5rem 0 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lead);
    line-height: var(--leading-body);
  }

  @media (min-width: 64rem) {
    .dock-essentials {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      min-height: clamp(38rem, 48vw, 48rem);
    }

    .essentials-image-wrapper {
      aspect-ratio: auto;
      min-height: 0;
    }
  }
</style>
