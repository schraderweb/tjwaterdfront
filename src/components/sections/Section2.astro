---
import Icon from "../ui/Icon.astro";
import DockEssentialsFeature from "./DockEssentialsFeature.astro";
import FeaturedServiceShowcase from "./FeaturedServiceShowcase.astro";
import { dockEssentials, featuredService, showcaseImages } from "../../data/section2";
---

<section class="section-2" id="services" aria-labelledby="section-2-title">
  <div class="section-2-container site-container">
    <div class="intro-statement">
      <Icon name="anchor" size={28} strokeWidth={1.35} class="intro-anchor" />
      <h2 id="section-2-title">
        We Offer Dock Services &amp; Repair, Boat &amp; Pontoon Lift Accessories,
        Seawalls, Boat Lifts, Beaches &amp; Retaining Walls, Patios, Boardwalks
        &amp; Deck Docks in <em>Michigan!</em>
      </h2>
    </div>

    <FeaturedServiceShowcase service={featuredService} images={showcaseImages} />

    <DockEssentialsFeature {...dockEssentials} />
  </div>
</section>

<style>
  .section-2 {
    background: var(--color-cream-50);
    color: var(--color-text-primary);
    padding-block: var(--space-section);
  }

  .section-2-container {
    display: flex;
    flex-direction: column;
    gap: clamp(4rem, 7vw, 8rem);
  }

  .intro-statement {
    display: grid;
    grid-template-columns: auto minmax(0, 62rem);
    align-items: start;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  :global(.intro-anchor) {
    margin-top: 0.55rem;
    color: var(--color-gold-600);
  }

  .intro-statement h2 {
    max-width: 62rem;
    margin: 0;
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: var(--tracking-heading);
  }

  .intro-statement em {
    color: var(--color-gold-600);
    font-style: normal;
  }

  @media (max-width: 39.999rem) {
    .intro-statement {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .intro-anchor { margin-top: 0; }
  }
</style>
