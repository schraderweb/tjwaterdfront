---
import { Image } from "astro:assets";
import ServicesHeader from "../services/ServicesHeader.astro";
import ServicesGrid from "../services/ServicesGrid.astro";
import ViewAllServices from "../services/ViewAllServices.astro";
import Icon from "../ui/Icon.astro";
import leafDecoration from "../../assets/services/leaf-decoration.png";
---

<section class="popular-services" aria-labelledby="popular-services-heading">
  <!-- Subtle decorative background elements -->
  <div class="decorative-bg" aria-hidden="true">
    <div class="watermark">
      <Icon name="anchor" size={400} strokeWidth={1} />
    </div>
    <Image src={leafDecoration} alt="" class="leaf-decoration" />
  </div>

  <div class="site-container content-container">
    <ServicesHeader />
    <ServicesGrid />
    <ViewAllServices />
  </div>
</section>

<style>
  .popular-services {
    position: relative;
    background-color: var(--color-cream-50, #f7f3eb);
    padding-block: clamp(4rem, 6vw, 7rem);
  }

  .decorative-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Extremely subtle anchor watermark as specified */
  .watermark {
    position: absolute;
    top: 5%;
    left: -5%;
    opacity: 0.03;
    color: var(--color-navy-950, #071a2d);
    transform: rotate(-15deg);
  }

  .leaf-decoration {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    opacity: 0.82;
  }

  .content-container {
    position: relative;
    z-index: 2;
  }

  @media (max-width: 640px) {
    .leaf-decoration {
      opacity: 0.65;
    }
  }
</style>
