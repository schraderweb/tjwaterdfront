---
import Icon from "../ui/Icon.astro";
import Button from "../ui/Button.astro";

const directionsUrl = "#";
---
<section class="location">
  <div class="location__map">
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2933.1825210665857!2d-83.85849259999999!3d42.678675899999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x882317102330b263%3A0xf160afbb7ef206c2!2sT%26J%20Waterfront%20Services!5e0!3m2!1sen!2sus!4v1786938602737!5m2!1sen!2sus"
      width="600"
      height="450"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      title="T&J Waterfront Services location map"
    ></iframe>
  </div>

  <div class="location__card-wrapper">
    <div class="location__card">
      <div class="location__card-header">
        <Icon name="anchor" class="location__title-icon" size={24} />
        <h2 class="location__title">Our Location</h2>
      </div>
      
      <div class="location__info">
        <div class="location__item">
          <Icon name="map-pin" class="location__icon" size={20} />
          <div class="location__text">
            <span>5385 Mack Rd.</span>
            <span>Howell, MI 48855</span>
          </div>
        </div>
        
        <div class="location__item">
          <Icon name="phone" class="location__icon" size={20} />
          <a href="tel:+15172945577" class="location__text location__link">+1 517-294-5577</a>
        </div>
        
        <div class="location__item">
          <Icon name="clock" class="location__icon" size={20} />
          <span class="location__text">Hours: 7:00 AM - 7:00 PM</span>
        </div>
      </div>
      
      <div class="location__action">
        <Button href={directionsUrl} variant="gold">GET DIRECTIONS</Button>
      </div>
    </div>
  </div>
</section>

<style>
.location {
  position: relative;
  width: 100%;
  display: flex;
  flex-direction: column;
}
.location__map {
  width: 100%;
  height: clamp(24rem, 45vw, 34rem);
  order: 1;
}
.location__map iframe {
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
  background-color: var(--color-cream-100);
}
.location__card-wrapper {
  width: 100%;
  padding: var(--space-stack-lg) var(--container-gutter);
  background-color: var(--color-navy-950);
  order: 2;
}
.location__card {
  color: var(--color-cream-50);
  display: flex;
  flex-direction: column;
  gap: var(--space-stack-lg);
  max-width: 24rem;
  margin-inline: auto;
}
.location__card-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.location__title-icon {
  color: var(--color-gold-500);
}
.location__title {
  font-family: var(--font-display);
  font-size: var(--text-h3);
  line-height: var(--leading-heading);
}
.location__info {
  display: flex;
  flex-direction: column;
  gap: var(--space-stack-md);
}
.location__item {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
}
.location__icon {
  color: var(--color-gold-500);
  flex-shrink: 0;
  margin-top: 0.125rem;
}
.location__text {
  display: flex;
  flex-direction: column;
  font-family: var(--font-sans);
  font-size: var(--text-body);
  line-height: var(--leading-body);
}
.location__link {
  text-decoration: none;
  color: inherit;
  transition: color var(--duration-fast) var(--ease-premium);
}
.location__link:hover {
  color: var(--color-gold-400);
}

@media (min-width: 768px) {
  .location {
    display: block;
  }
  .location__map {
    height: clamp(30rem, 45vw, 40rem);
  }
  .location__card-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    display: flex;
    align-items: center;
    padding-inline: var(--container-gutter);
    background-color: transparent;
  }
  .location__card {
    pointer-events: auto;
    width: 100%;
    margin-inline: 0;
    background-color: var(--color-navy-950);
    padding: clamp(2rem, 3vw, 3rem);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-panel);
    border: var(--border-dark);
  }
}
</style>
