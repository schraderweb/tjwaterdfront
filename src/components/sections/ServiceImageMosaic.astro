---
/**
 * ServiceImageMosaic.astro
 * The 6-image CSS Grid composition.
 */

interface ImageProp {
  src: string;
  alt: string;
  focalPoint?: string; // e.g. 'center', '60% center'
}

interface Props {
  images: ImageProp[];
}

const { images } = Astro.props;

// Ensure we only render exactly 6 images
const displayImages = images.slice(0, 6);
---

<div class="service-image-mosaic">
  {displayImages.map((image, index) => (
    <div class="image-wrapper">
      <img
        src={image.src}
        alt={image.alt}
        loading="lazy"
        class="mosaic-img"
        style={`object-position: ${image.focalPoint || 'center'};`}
      />
    </div>
  ))}
</div>

<style>
  .service-image-mosaic {
    display: grid;
    /* On mobile, use 1 column, maybe 2 for slightly larger */
    grid-template-columns: 1fr;
    gap: 0.5rem; /* Gutters between images */
    height: 100%;
  }

  @media (min-width: 640px) {
    .service-image-mosaic {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }
  }

  @media (min-width: 1024px) {
    .service-image-mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    /* Give a default height to prevent collapsing, especially on mobile/tablet */
    min-height: 250px;
    height: 100%;
    overflow: hidden;
  }

  /* On desktop, allow the grid to dictate height naturally to match the panel's height, 
     or let the panel dictate height. We'll set a base height for consistency. */
  @media (min-width: 1024px) {
    .image-wrapper {
      min-height: 200px;
    }
  }

  .mosaic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-premium);
  }

  .image-wrapper:hover .mosaic-img {
    transform: scale(1.03);
  }
</style>
