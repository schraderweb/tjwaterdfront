---
import { Picture } from "astro:assets";

export interface GalleryImage {
  src: ImageMetadata;
  alt: string;
  size?: "small" | "medium" | "large" | "tall" | "wide";
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<section class="project-gallery">
  <div class="site-container">
    <div class="gallery-grid">
      {images.map((img) => (
        <div class={`gallery-item size-${img.size || 'medium'}`}>
          <Picture 
            src={img.src} 
            alt={img.alt} 
            formats={["avif", "webp"]} 
            class="gallery-image"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
          />
          <div class="hover-overlay" aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .project-gallery {
    background-color: var(--color-cream-50, #f7f3eb);
    padding-block: clamp(4rem, 8vw, 8rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: clamp(1rem, 2vw, 2.5rem);
    grid-auto-flow: dense;
  }

  .gallery-item {
    position: relative;
    overflow: hidden;
    background-color: var(--color-cream-200, #e0d8c8);
    /* Soft shadow to lift it slightly */
    box-shadow: 0 10px 30px rgba(5, 20, 35, 0.05);
    border-radius: 4px;
    cursor: pointer;
  }

  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Hover overlay */
  .hover-overlay {
    position: absolute;
    inset: 0;
    background: var(--color-navy-950, #071a2d);
    opacity: 0;
    mix-blend-mode: multiply;
    transition: opacity 0.5s var(--ease-premium, cubic-bezier(0.2, 0.8, 0.2, 1));
  }

  .gallery-item:hover .hover-overlay {
    opacity: 0.15;
  }

  .gallery-item:hover .gallery-image {
    transform: scale(1.03);
  }

  /* Asymmetrical Sizing based on 12-col grid */
  
  .size-large {
    grid-column: span 12;
    aspect-ratio: 16/9;
  }

  .size-wide {
    grid-column: span 8;
    aspect-ratio: 16/10;
  }

  .size-tall {
    grid-column: span 4;
    grid-row: span 2;
    aspect-ratio: 3/4;
  }

  .size-medium {
    grid-column: span 6;
    aspect-ratio: 4/3;
  }

  .size-small {
    grid-column: span 4;
    aspect-ratio: 1/1;
  }

  @media (max-width: 64rem) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .size-large, .size-wide, .size-medium {
      grid-column: span 2;
    }

    .size-tall, .size-small {
      grid-column: span 1;
    }
  }

  @media (max-width: 40rem) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .gallery-item {
      grid-column: span 1 !important;
      aspect-ratio: 4/3;
    }
  }
</style>
