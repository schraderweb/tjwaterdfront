---
import { Image } from "astro:assets";
import Icon from "@/components/shared/ui/Icon.astro";

interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  icon: string;
  href: string;
}

const { title, description, image, icon, href } = Astro.props;
---

<a href={href} class="service-card group" aria-label={`Learn more about ${title}`}>
  <div class="card-image-wrap">
    <Image 
      src={image} 
      alt={`Photograph of ${title}`} 
      width={800}
      height={600}
      class="card-image"
    />
    <div class="card-gradient"></div>
  </div>
  
  <div class="card-content">
    <div class="card-icon-wrap">
      <Icon name={icon} size={24} strokeWidth={1.8} class="card-icon" />
    </div>
    <div class="card-text-header">
      <h3 class="card-title">{title}</h3>
      <span class="card-arrow" aria-hidden="true">
        <Icon name="arrow-right" size={20} strokeWidth={2} />
      </span>
    </div>
    <p class="card-description">{description}</p>
  </div>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    border-radius: 8px; /* Restrained radius as per specs */
    text-decoration: none;
    aspect-ratio: 4 / 3; /* Stable layout */
    background: var(--color-navy-950, #071a2d);
  }

  .card-image-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 600ms cubic-bezier(0.2, 0.65, 0.2, 1);
  }

  .card-gradient {
    position: absolute;
    inset: 0;
    /* Layered gradient from specs — strengthened around the content */
    background: linear-gradient(
      to bottom,
      rgba(7, 26, 45, 0.02) 15%,
      rgba(7, 26, 45, 0.18) 40%,
      rgba(7, 26, 45, 0.82) 75%,
      rgba(7, 26, 45, 0.97) 100%
    );
    transition: opacity 400ms ease;
  }

  .card-content {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    padding: 2rem;
    color: var(--color-cream-50, #f7f3eb);
  }

  .card-icon-wrap {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border: 1.5px solid rgba(201, 145, 54, 0.95);
    border-radius: 50%;
    background: rgba(7, 26, 45, 0.72);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    color: #c99136;
    position: relative;
    z-index: 3;
    margin-bottom: 0.5rem;
  }

  .card-text-header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
  }

  .card-title {
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.25rem, 1.6vw, 1.65rem);
    font-weight: 400;
    color: var(--color-cream-50, #f7f3eb);
  }

  .card-arrow {
    color: var(--color-gold-600, #b98232);
    transition: transform 600ms cubic-bezier(0.2, 0.65, 0.2, 1);
    display: flex;
    align-items: center;
  }

  .card-description {
    margin: 0;
    font-family: var(--font-body, sans-serif);
    font-size: 15px;
    line-height: 1.5;
    color: rgba(247, 243, 235, 0.85); /* Slightly reduced opacity */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Hover interactions */
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover .card-image {
      transform: scale(1.04);
    }
    .service-card:hover .card-arrow {
      transform: translateX(5px);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .card-image, .card-arrow {
      transition: none;
    }
    .service-card:hover .card-image {
      transform: none;
    }
    .service-card:hover .card-arrow {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .service-card {
      aspect-ratio: 1 / 1;
    }
    .card-content {
      padding: 1.5rem;
    }
  }
</style>
