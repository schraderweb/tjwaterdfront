---
import Icon from "@/components/shared/ui/Icon.astro";
---

<div class="view-all-container">
  <a href="/services" class="view-all-btn group" aria-label="View all our services">
    <span>VIEW ALL SERVICES</span>
    <span class="btn-arrow" aria-hidden="true">
      <Icon name="arrow-right" size={16} strokeWidth={2} />
    </span>
  </a>
</div>

<style>
  .view-all-container {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 4vw, 4rem);
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    border: 1px solid var(--color-gold-600, #b98232);
    border-radius: 4px;
    background-color: transparent;
    color: var(--color-gold-600, #b98232);
    font-family: var(--font-body, sans-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 400ms ease;
  }

  .btn-arrow {
    display: inline-flex;
    transition: transform 400ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .view-all-btn:hover {
      background-color: rgba(185, 130, 50, 0.05); /* Subtle gold tint */
      color: var(--color-navy-950, #071a2d);
      border-color: var(--color-navy-950, #071a2d);
    }
    
    .view-all-btn:hover .btn-arrow {
      transform: translateX(4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .view-all-btn, .btn-arrow {
      transition: none;
    }
    .view-all-btn:hover .btn-arrow {
      transform: none;
    }
  }
</style>
