---
import Icon from "@/components/shared/ui/Icon.astro";
import DockEssentialsFeature from "@/components/pages/home/sections/DockEssentialsFeature.astro";
import FeaturedServiceShowcase from "@/components/pages/home/sections/FeaturedServiceShowcase.astro";
import { dockEssentials, featuredService, showcaseImages } from "@/data/featuredServices";
---

<section class="featured-services" id="services" aria-labelledby="featured-services-title">
  <div class="featured-services-container site-container">
    <div class="intro-statement">
      <Icon name="anchor" size={28} strokeWidth={1.35} class="intro-anchor" />
      <h2 id="featured-services-title">
        We Offer Dock Services &amp; Repair, Boat &amp; Pontoon Lift Accessories,
        Seawalls, Boat Lifts, Beaches &amp; Retaining Walls, Patios, Boardwalks
        &amp; Deck Docks in <em>Michigan!</em>
      </h2>
    </div>

    <div class="showcase-wrap">
      <FeaturedServiceShowcase service={featuredService} images={showcaseImages} />
    </div>

    <DockEssentialsFeature {...dockEssentials} />
  </div>
</section>

<style>
  .featured-services {
    background: var(--color-cream-50);
    color: var(--color-text-primary);
    padding-block: clamp(3rem, 4vw, 5rem);
  }

  .featured-services-container {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .intro-statement {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: clamp(1rem, 2vw, 1.75rem);
    margin-bottom: clamp(2rem, 3vw, 4rem);
  }

  :global(.intro-anchor) {
    margin-top: 0.55rem;
    color: var(--color-gold-600);
  }

  .intro-statement h2 {
    max-width: 90rem;
    margin: 0;
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: var(--tracking-heading);
  }

  .showcase-wrap {
    margin-bottom: clamp(3rem, 4vw, 5rem);
  }

  .intro-statement em {
    color: var(--color-gold-600);
    font-style: normal;
  }

  @media (max-width: 39.999rem) {
    .intro-statement {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .intro-anchor { margin-top: 0; }
  }
</style>
