---
/**
 * Hero.astro — full-first-viewport hero.
 *
 * Height model (design doc §56):
 *   min-height: 100svh (flex column)
 *   navbar is fixed/overlaying → padding-top reserved in .hero-main
 *   .hero-main flexes to fill, service bar takes natural height
 *
 * Image: absolutely-positioned <Picture> with object-fit: cover —
 * mathematical cropping, no JS, no fixed pixel heights. LCP-optimized:
 * eager, fetchpriority=high, responsive widths, modern formats.
 */
import { Picture } from "astro:assets";
import heroImage from "@/assets/hero/new-home-hero.webp";
import HeroContent from "@/components/pages/home/hero/HeroContent.astro";
import QuoteForm from "@/components/pages/home/hero/QuoteForm.astro";
import HeroServicesBar from "@/components/pages/home/hero/HeroServicesBar.astro";
---

<section class="hero" id="hero" aria-label="Introduction">
  <div class="hero-media">
    <Picture
      src={heroImage}
      formats={["avif", "webp"]}
      fallbackFormat="jpg"
      widths={[640, 828, 1024, 1280, 1536, 1920, 2200, 2560, 3840]}
      sizes="max(100vw, 178vh)"
      alt="Bright Michigan waterfront with dock and boat lift over calm blue lake water"
      quality={62}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      pictureAttributes={{ class: "hero-picture" }}
      class="hero-img"
    />
  </div>

  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="hero-main">
    <div class="site-container hero-grid">
      <HeroContent />
      <QuoteForm />
    </div>
  </div>

  <HeroServicesBar />
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100vh;
    height: 100svh;
    min-height: 100svh;
    max-height: 100svh;
    overflow: hidden;
    background: var(--color-navy-900);
    /*
      Focal point token — adjust here after visual QA on real screenshots
      without touching component markup.
    */
    --hero-focus-x: center;
    --hero-focus-y: center;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: var(--z-base);
  }

  .hero-media :global(picture),
  .hero-media :global(.hero-picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-focus-x) var(--hero-focus-y);
  }

  /* Tall narrow screens (phones, portrait tablets): bias toward the
     waterline so the composition stays intentional while cropping sides. */
  @media (max-aspect-ratio: 3 / 4) {
    .hero {
      --hero-focus-x: 62%;
      --hero-focus-y: 38%;
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: var(--z-overlay);
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.7) 0%,
        rgba(255, 255, 255, 0.4) 38%,
        rgba(255, 255, 255, 0) 75%
      ),
      linear-gradient(
        to top,
        rgba(7, 26, 43, 0.5) 0%,
        rgba(7, 26, 43, 0.15) 15%,
        rgba(7, 26, 43, 0) 30%
      );
  }

  .hero-main {
    position: relative;
    z-index: var(--z-content);
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    width: 100%;
    padding-top: calc(4.25rem + clamp(0.25rem, 1vh, 1.25rem));
    padding-bottom: clamp(0.25rem, 0.75vh, 0.75rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    align-items: center;
    width: calc(100% - 2 * var(--hero-gutter));
    max-width: var(--container-xl);
  }

  /* Two-column split once the form panel has room to breathe */
  @media (min-width: 64rem) {
    .hero-main {
      padding-top: calc(4.5rem + clamp(0.25rem, 1vh, 1.25rem));
      padding-bottom: clamp(0.25rem, 0.75vh, 0.75rem);
    }
    .hero-grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(26rem, 0.85fr);
      gap: clamp(1.5rem, 3.5vw, 4.5rem);
    }
  }

  /* Compact viewports (short laptops): tighten vertical rhythm so the
     first viewport stays composed without clipping. */
  @media (min-width: 64rem) and (max-height: 920px) {
    .hero-main {
      padding-top: calc(4.25rem + 0.5rem);
      padding-bottom: 0.5rem;
    }
  }

  @media (max-width: 63.999rem) {
    .hero {
      height: auto;
      max-height: none;
      min-height: 100svh;
      overflow: visible;
    }
    .hero-grid {
      width: calc(100% - 2 * var(--container-gutter));
    }
  }
</style>
