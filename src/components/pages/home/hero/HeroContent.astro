---
/**
 * HeroContent.astro — eyebrow, editorial serif H1, supporting copy, actions.
 * Fluid clamp() typography; gold is used as jewelry (one highlighted line).
 */
import GoldLine from "@/components/shared/ui/GoldLine.astro";
import HeroActions from "@/components/pages/home/hero/HeroActions.astro";
---

<div class="hero-content">
  <p class="eyebrow hero-eyebrow">Built for Michigan. Built to last.</p>

  <h1 class="hero-title">
    <span>Premium</span>
    <span>Waterfront</span>
    <span>Solutions.</span>
    <span class="hero-title-accent">Built Around You.</span>
  </h1>

  <GoldLine class="hero-rule" />

  <p class="hero-copy">
    From docks and seawalls to patios and beaches, we design and build lasting
    waterfront spaces that elevate your lifestyle.
  </p>

  <HeroActions />
</div>

<style>
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.35rem);
    max-width: 60rem;
  }

  .hero-eyebrow {
    margin: 0;
    color: var(--color-gold-700);
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
  }

  .hero-title {
    margin: 0;
    max-width: 58rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.5rem, 4.75vw, 6.75rem);
    line-height: 0.91;
    letter-spacing: -0.045em;
    color: var(--color-navy-950);
    text-wrap: balance;
    text-shadow: 
      0 0 15px rgba(255, 255, 255, 0.9),
      0 0 30px rgba(255, 255, 255, 0.7),
      0 0 45px rgba(255, 255, 255, 0.4);
  }

  .hero-title span {
    display: block;
  }

  .hero-title-accent {
    color: var(--color-gold-600);
  }

  .hero-rule {
    margin-top: clamp(0.15rem, 0.1rem + 0.25vw, 0.35rem);
  }

  .hero-copy {
    margin: 0;
    max-width: 38ch;
    font-size: clamp(0.95rem, 0.85rem + 0.3vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-navy-900);
    text-shadow: 
      0 0 10px rgba(255, 255, 255, 0.9),
      0 0 20px rgba(255, 255, 255, 0.7);
  }

  /* Desktop viewports: balance typography to ensure full first viewport fit */
  @media (min-width: 64rem) {
    .hero-content {
      gap: clamp(0.45rem, 0.75vh, 0.85rem);
    }
    .hero-title {
      font-size: clamp(2.35rem, 3.4vw, 4.25rem);
      line-height: 0.94;
    }
    .hero-copy {
      font-size: clamp(0.9rem, 0.95vw, 1.05rem);
      line-height: 1.45;
    }
  }

  @media (max-width: 63.999rem) {
    .hero-title {
      max-width: 36rem;
    }
  }
</style>
