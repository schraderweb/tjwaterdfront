---
/**
 * HeroServicesBar.astro — four dock services along the hero's bottom edge.
 * Desktop: 4 equal columns with subtle dividers.
 * Mobile: horizontally scrollable with snap — never four squeezed columns.
 */
import Icon from "@/components/shared/ui/Icon.astro";
import { heroServices } from "@/data/site";

const iconMap: Record<string, string> = {
  docks: "sectional-docks",
  lifts: "anchor",
  seawalls: "shield-check",
  "decks-boardwalks": "house",
};
---

<div class="service-bar" role="navigation" aria-label="Featured services">
  <div class="site-container">
    <ul class="service-list">
      {
        heroServices.map((service) => (
          <li class="service-item">
            <a href={service.href} class="service-link">
              <span class="service-icon" aria-hidden="true">
                <Icon
                  name={iconMap[service.icon] ?? "anchor"}
                  size={28}
                  strokeWidth={1.4}
                />
              </span>
              <span class="service-text">
                <span class="service-title">{service.title}</span>
                <span class="service-desc">{service.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .service-bar {
    position: relative;
    z-index: 10;
    flex: 0 0 auto;
    background: rgba(7, 26, 43, 0.88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-top: 2px solid rgba(198, 146, 61, 0.65);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
  }

  .service-bar > .site-container {
    width: calc(100% - 2 * var(--container-gutter));
    max-width: var(--container-xl);
  }

  .service-list {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .service-list::-webkit-scrollbar {
    display: none;
  }

  .service-item {
    flex: 1 0 auto;
    min-width: min(16rem, 80vw);
    scroll-snap-align: start;
    border-inline-start: 1px solid rgba(255, 255, 255, 0.22);
  }

  .service-item:first-child {
    border-inline-start: 0;
  }

  .service-link {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1vw, 1.25rem);
    height: 100%;
    padding: clamp(0.6rem, 0.85vh, 0.85rem)
      clamp(0.75rem, 0.85vw, 1.25rem);
    text-decoration: none;
    transition: background-color var(--duration-base) var(--ease-premium);
  }

  .service-link:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .service-icon {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-white);
    transition: color var(--duration-base) var(--ease-premium);
  }

  .service-icon :global(svg) {
    display: block;
    color: var(--color-white);
    transition: color var(--duration-base) var(--ease-premium), transform var(--duration-base) var(--ease-premium);
  }

  .service-link:hover .service-icon :global(svg) {
    color: var(--color-gold-400);
    transform: scale(1.08);
  }

  .service-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .service-title {
    font-size: clamp(0.95rem, 0.9vw, 1.15rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-white);
  }

  .service-desc {
    max-width: 28ch;
    font-size: clamp(0.7rem, 0.72vw, 0.8rem);
    line-height: 1.35;
    color: rgba(246, 241, 231, 0.86);
  }

  /* Desktop: four true columns */
  @media (min-width: 64rem) {
    .service-list {
      overflow-x: visible;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
