---
import { Image } from 'astro:assets';
import OfferGlassPanel from "@/components/pages/home/resources/OfferGlassPanel.astro";
import promotionalBg from "@/assets/resources/promotional-bg.webp";
---

<section class="promotional-offer">
  <div class="promotional-bg">
    <Image src={promotionalBg} alt="Michigan Waterfront Dock" class="bg-image" />
    <div class="bg-overlay"></div>
  </div>
  <div class="promotional-content">
    <OfferGlassPanel />
  </div>
</section>

<style>
  .promotional-offer {
    position: relative;
    padding: clamp(1.5rem, 5vw, 3rem) var(--container-gutter, 2rem);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    min-height: 0;
  }

  .promotional-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }

  .bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.1);
  }

  .promotional-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-lg, 1200px);
  }

  @media (min-width: 64rem) {
    .promotional-offer {
      min-height: 18.5rem;
      padding-block: 1.5rem;
    }
  }
</style>
