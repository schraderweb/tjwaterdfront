---
---
<div class="resources-header">
  <span class="eyebrow">HELPFUL RESOURCES</span>
  <h2 class="title">Our Latest Helpful Tips</h2>
  <div class="decorative-divider">
    <div class="line"></div>
  </div>
</div>

<style>
  .resources-header {
    text-align: center;
    margin-bottom: var(--space-stack-lg, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow {
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow, 0.75rem);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow, 0.28em);
    color: var(--color-gold-500, #c6923d);
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .title {
    font-family: var(--font-display);
    font-size: var(--text-h2, 3rem);
    color: var(--color-cream-50, #fcfaf5);
    font-weight: 400;
    margin: 0 0 1.5rem 0;
    line-height: var(--leading-heading, 1.1);
  }

  .decorative-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
  }

  .line {
    height: 1px;
    width: 100%;
    background: var(--color-gold-500, #c6923d);
  }

  @media (min-width: 64rem) {
    .resources-header {
      margin-bottom: 1rem;
    }
  }
</style>
