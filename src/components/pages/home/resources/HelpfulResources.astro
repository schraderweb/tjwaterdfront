---
import { Image } from 'astro:assets';
import ResourcesHeader from "@/components/pages/home/resources/ResourcesHeader.astro";
import ResourceItem from "@/components/pages/home/resources/ResourceItem.astro";
import { helpfulResources } from "@/data/helpfulResources";
import resourcesBg from "@/assets/resources/resources-bg.webp";
---

<section class="helpful-resources">
  <div class="resources-bg">
    <Image src={resourcesBg} alt="Dark Michigan Waterfront" class="bg-image" />
    <div class="bg-overlay"></div>
  </div>
  
  <div class="resources-content">
    <ResourcesHeader />
    
    <div class="resources-grid">
      {helpfulResources.map((resource, index) => (
        <>
          <div class="resource-cell">
            <ResourceItem resource={resource} />
          </div>
          {index < helpfulResources.length - 1 && <div class="resource-separator"></div>}
        </>
      ))}
    </div>

    <p class="resources-view-all">
      To View All Of Our Articles Please <a href="/helpful-tips">Click Here</a>.
    </p>
  </div>
</section>

<style>
  .helpful-resources {
    position: relative;
    padding: clamp(4.5rem, 7vw, 7rem) var(--container-gutter, 2rem);
    display: flex;
    justify-content: center;
    overflow: hidden;
  }

  .resources-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }

  .bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(4, 21, 37, 0.82),
      rgba(4, 21, 37, 0.92)
    );
  }

  .resources-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-xl, 1440px);
  }

  .resources-grid {
    display: flex;
    justify-content: center;
    align-items: stretch;
  }

  .resource-cell {
    flex: 1;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
  }

  .resource-separator {
    width: 1px;
    background: rgba(247, 243, 235, 0.15);
    margin: 1rem 0;
  }

  .resources-view-all {
    margin: clamp(3rem, 5vw, 4.5rem) 0 0;
    text-align: center;
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.125rem);
    font-weight: 500;
    line-height: 1.6;
    color: rgba(252, 250, 245, 0.85);
  }

  .resources-view-all a {
    color: var(--color-gold-500, #c6923d);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(198, 146, 61, 0.55);
    text-underline-offset: 0.2em;
    transition: color var(--duration-fast, 180ms) ease;
  }

  .resources-view-all a:hover,
  .resources-view-all a:focus-visible {
    color: var(--color-gold-400, #d9ae62);
  }

  @media (max-width: 1024px) {
    .resources-grid {
      flex-wrap: wrap;
    }
    
    .resource-cell {
      flex: 0 0 50%;
      margin-bottom: 2rem;
    }
    
    .resource-separator {
      display: none;
    }
    
    /* Re-add separators for 2x2 grid if desired, but hidden usually works better on tablet */
  }

  @media (max-width: 640px) {
    .resource-cell {
      flex: 0 0 100%;
      margin-bottom: 2rem;
      border-bottom: 1px solid rgba(247, 243, 235, 0.15);
      padding-bottom: 2rem;
    }

    .resource-cell:last-child {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }
  }

  @media (min-width: 64rem) {
    .helpful-resources {
      padding-block: clamp(5rem, 8vw, 8rem);
    }
  }
</style>
