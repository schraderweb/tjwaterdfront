---
import { serviceAreas } from "@/data/serviceAreas";
---

<section class="service-areas-section" id="service-areas" aria-labelledby="service-areas-title">
  <div class="site-container">
    <div class="section-header">
      <span class="eyebrow">PROUDLY SERVING</span>
      <h2 id="service-areas-title">All of The Below Listed Areas</h2>
    </div>
    
    <div class="areas-content-wrapper">
      <div class="areas-list">
        {serviceAreas.map((area, index) => (
          <>
            <span class="area-name">{area}</span>
            {index < serviceAreas.length - 1 && <span class="area-separator" aria-hidden="true">&bull;</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .service-areas-section {
    background-color: var(--color-navy-950, #041525);
    color: var(--color-cream-50, #fcfaf5);
    padding-block: clamp(4rem, 6vw, 6rem);
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .eyebrow {
    display: block;
    color: var(--color-gold-600, #b98232);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    font-family: var(--font-display);
    color: var(--color-cream-50, #fcfaf5);
    font-size: clamp(2rem, 3vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
  }

  .areas-content-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    padding-inline: 2.5rem;
    border-left: 1px solid rgba(185, 130, 50, 0.5); /* Using gold with some opacity for the thin lines */
    border-right: 1px solid rgba(185, 130, 50, 0.5);
  }

  .areas-list {
    text-align: center;
    line-height: 2.4;
    font-size: clamp(0.95rem, 1.2vw, 1.05rem);
  }

  .area-name {
    display: inline-block;
    color: var(--color-cream-100, #f6f1e7);
    letter-spacing: 0.02em;
  }

  .area-separator {
    color: var(--color-gold-600, #b98232);
    margin: 0 0.75rem;
    font-size: 1.1em;
    vertical-align: middle;
  }

  @media (max-width: 600px) {
    .areas-content-wrapper {
      padding-inline: 1rem;
      border-left: none;
      border-right: none;
    }
    
    .areas-list {
      line-height: 2;
    }
    
    .area-separator {
      margin: 0 0.4rem;
    }
  }
</style>
