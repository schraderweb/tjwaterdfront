---
import { site } from "@/data/site";
import Button from "@/components/shared/ui/Button.astro";
import Icon from "@/components/shared/ui/Icon.astro";
---

<section class="contact-section">
  <div class="site-container">
    <div class="contact-grid">
      <div class="contact-info-panel">
        <span class="eyebrow">GET IN TOUCH</span>
        <h2>Ready to transform your waterfront?</h2>
        
        <div class="contact-details">
          <div class="detail-item">
            <Icon name="anchor" size={24} strokeWidth={1.5} />
            <div>
              <strong>Address</strong>
              <p>{site.address.street}<br/>{site.address.city}, {site.address.state} {site.address.zip}</p>
            </div>
          </div>
          
          <div class="detail-item">
            <Icon name="phone" size={24} strokeWidth={1.5} />
            <div>
              <strong>Phone</strong>
              <p><a href={site.phoneHref}>{site.phoneDisplay}</a></p>
            </div>
          </div>

          <div class="detail-item">
            <Icon name="clock" size={24} strokeWidth={1.5} />
            <div>
              <strong>Hours</strong>
              <p>{site.hours}</p>
            </div>
          </div>
        </div>

        <div class="cta-wrapper">
          <Button href="/contact" variant="primary" class="contact-btn">
            START YOUR PROJECT <span aria-hidden="true">&rarr;</span>
          </Button>
        </div>
      </div>

      <div class="map-panel">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2933.1825210665857!2d-83.85849259999999!3d42.678675899999995!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x882317102330b263%3A0xf160afbb7ef206c2!2sT%26J%20Waterfront%20Services!5e0!3m2!1sen!2sus!4v1786938602737!5m2!1sen!2sus"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title="T&J Waterfront Services location map"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: var(--color-navy-950, #071a2d);
    padding-block: clamp(4rem, 8vw, 8rem);
    color: var(--color-cream-50, #f7f3eb);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  .contact-info-panel {
    padding: clamp(1.75rem, 4vw, 3.25rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: rgba(11, 34, 54, 0.45);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border-radius: var(--radius-md, 0.875rem);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .eyebrow {
    color: var(--color-gold-400, #d4af37);
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow, 0.8125rem);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow, 0.15em);
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: block;
  }

  h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 2.5rem;
    color: var(--color-cream-50, #f7f3eb);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .detail-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    color: var(--color-cream-200, #e0d8c8);
  }

  .detail-item :global(svg) {
    color: var(--color-gold-400, #d4af37);
    margin-top: 0.15rem;
  }

  .detail-item strong {
    display: block;
    color: var(--color-cream-50, #f7f3eb);
    font-family: var(--font-sans);
    font-weight: 600;
    margin-bottom: 0.25rem;
    letter-spacing: 0.02em;
  }

  .detail-item p {
    margin: 0;
    line-height: 1.5;
  }

  .detail-item a {
    color: var(--color-cream-200, #e0d8c8);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .detail-item a:hover {
    color: var(--color-gold-400, #d4af37);
  }

  .cta-wrapper {
    margin-top: auto;
  }

  .contact-btn {
    width: 100%;
    justify-content: center;
  }

  .map-panel {
    position: relative;
    border-radius: var(--radius-md, 0.875rem);
    overflow: hidden;
    background-color: var(--color-cream-100);
  }

  .map-panel iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 30rem;
  }

  @media (max-width: 48rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .map-panel iframe {
      min-height: clamp(20rem, 40vw, 26rem);
    }
  }
</style>
