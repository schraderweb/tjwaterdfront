--- 
import Icon from "@/components/shared/ui/Icon.astro";
import Button from "@/components/shared/ui/Button.astro";
import { site } from "@/data/site";

const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__grid">
      
      <!-- Brand Column -->
      <div class="site-footer__col site-footer__brand-col">
        <div class="site-footer__logo">
          <Icon name="anchor" class="site-footer__logo-icon" size={32} />
          <div class="site-footer__logo-text">
            <span class="site-footer__logo-name">T&J WATERFRONT</span>
            <span class="site-footer__logo-sub">SERVICES</span>
          </div>
        </div>
        <p class="site-footer__brand-text">
          Built for Michigan. Built to last.<br>
          Premium waterfront solutions you can<br>
          count on, year after year.
        </p>
        <div class="site-footer__social">
          <a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="site-footer__social-link">
            <Icon name="facebook" size={20} />
          </a>
          <a href={`mailto:${site.email}`} aria-label="Email" class="site-footer__social-link">
            <Icon name="mail" size={20} />
          </a>
        </div>
      </div>

      <!-- Quick Links Column -->
      <div class="site-footer__col">
        <h3 class="site-footer__heading">QUICK LINKS</h3>
        <ul class="site-footer__list">
          <li><a href="/" class="site-footer__link"><Icon name="chevron-right" size={14}/> Home</a></li>
          <li><a href="/services" class="site-footer__link"><Icon name="chevron-right" size={14}/> Services</a></li>
          <li><a href="/service-areas" class="site-footer__link"><Icon name="chevron-right" size={14}/> Service Areas</a></li>
          <li><a href="/gallery" class="site-footer__link"><Icon name="chevron-right" size={14}/> Gallery</a></li>
          <li><a href="/about" class="site-footer__link"><Icon name="chevron-right" size={14}/> About Us</a></li>
          <li><a href="/contact" class="site-footer__link"><Icon name="chevron-right" size={14}/> Contact Us</a></li>
        </ul>
      </div>

      <!-- Services Column -->
      <div class="site-footer__col">
        <h3 class="site-footer__heading">OUR SERVICES</h3>
        <ul class="site-footer__list">
          <li><a href="/services/dock-services" class="site-footer__link"><Icon name="chevron-right" size={14}/> Dock Services & Repair</a></li>
          <li><a href="/services/lift-accessories" class="site-footer__link"><Icon name="chevron-right" size={14}/> Boat & Pontoon Lift Accessories</a></li>
          <li><a href="/services/seawalls" class="site-footer__link"><Icon name="chevron-right" size={14}/> Seawalls</a></li>
          <li><a href="/services/boat-lifts" class="site-footer__link"><Icon name="chevron-right" size={14}/> Boat Lifts</a></li>
          <li><a href="/services/beaches" class="site-footer__link"><Icon name="chevron-right" size={14}/> Beaches</a></li>
          <li><a href="/services/retaining-walls" class="site-footer__link"><Icon name="chevron-right" size={14}/> Retaining Walls</a></li>
        </ul>
      </div>

      <!-- Contact Column -->
      <div class="site-footer__col">
        <h3 class="site-footer__heading">CONTACT US</h3>
        <ul class="site-footer__contact-list">
          <li>
            <Icon name="map-pin" class="site-footer__contact-icon" size={18} />
            <div class="site-footer__contact-text">
              <span>5385 Mack Rd.</span>
              <span>Howell, MI 48855</span>
            </div>
          </li>
          <li>
            <Icon name="phone" class="site-footer__contact-icon" size={18} />
            <a href="tel:+15172945577" class="site-footer__contact-link">+1 517-294-5577</a>
          </li>
          <li>
            <Icon name="clock" class="site-footer__contact-icon" size={18} />
            <span class="site-footer__contact-text">7:00 AM - 7:00 PM</span>
          </li>
        </ul>
        <div class="site-footer__cta">
          <Button href="/contact" variant="navy-outline" size="sm">GET A FREE QUOTE</Button>
        </div>
      </div>

      <!-- Newsletter Column -->
      <div class="site-footer__col">
        <h3 class="site-footer__heading">STAY UPDATED</h3>
        <p class="site-footer__newsletter-text">Subscribe for tips, updates, and special offers.</p>
        <form class="site-footer__form" action="#" method="POST" data-newsletter-form novalidate>
          <input type="email" name="email" placeholder="Enter your email address" required class="site-footer__input" />
          <button type="submit" aria-label="Subscribe" class="site-footer__submit">
            <Icon name="arrow-right" size={18} />
          </button>
        </form>
        <p class="site-footer__form-status" data-newsletter-status role="status" aria-live="polite"></p>
        
        <div class="site-footer__trust">
          <Icon name="shield" class="site-footer__trust-icon" size={20} />
          <span class="site-footer__trust-text">Licensed & Insured | Michigan Based</span>
        </div>
      </div>

    </div>
  </div>
</footer>

<div class="schrader-bar" aria-label="Copyright and legal links">
  <span>
    &copy; {currentYear} T&amp;J Waterfront Services. All Rights Reserved.
  </span>
  <span class="schrader-bar__divider" aria-hidden="true"></span>
  <span class="schrader-bar__legal">
    <a href="/privacy-policy">Privacy Policy</a>
    <span class="schrader-bar__divider" aria-hidden="true"></span>
    <a href="/terms-and-conditions">Terms &amp; Conditions</a>
    <span class="schrader-bar__divider" aria-hidden="true"></span>
    <a href="/cookie-policy">Cookie Policy</a>
  </span>
  <span class="schrader-bar__divider" aria-hidden="true"></span>
  <span>
    Website Design by{" "}
    <a href="https://schrader.co/" target="_blank" rel="noopener noreferrer">
      Schrader Web Design
    </a>
  </span>
</div>

<style>
.site-footer {
  background-color: var(--color-navy-950);
  color: var(--color-cream-100);
  padding-top: clamp(2.5rem, 4vw, 4.5rem);
  border-top: var(--border-dark);
}
.site-footer__container {
  width: min(calc(100% - 2 * var(--container-gutter)), var(--container-xl));
  margin-inline: auto;
}
.site-footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-stack-md);
  padding-bottom: clamp(2.5rem, 4vw, 4.5rem);
}

@media (min-width: 768px) {
  .site-footer__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .site-footer__grid {
    grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr 2fr;
    gap: 2rem;
  }
}

.site-footer__col {
  display: flex;
  flex-direction: column;
}

/* Brand Area */
.site-footer__brand-col {
  padding-right: 1rem;
}
.site-footer__logo {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: var(--space-stack-md);
}
.site-footer__logo-icon {
  color: var(--color-gold-500);
}
.site-footer__logo-text {
  display: flex;
  flex-direction: column;
}
.site-footer__logo-name {
  font-family: var(--font-display);
  font-size: var(--text-h4);
  line-height: 1;
  color: var(--color-cream-50);
}
.site-footer__logo-sub {
  font-family: var(--font-sans);
  font-size: var(--text-tiny);
  letter-spacing: 0.2em;
  color: var(--color-gold-500);
}
.site-footer__brand-text {
  font-family: var(--font-sans);
  font-size: var(--text-small);
  line-height: var(--leading-body);
  color: var(--color-text-on-dark);
  margin-bottom: var(--space-stack-md);
  opacity: 0.8;
}
.site-footer__social {
  display: flex;
  gap: 1rem;
}
.site-footer__social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--color-cream-100);
  transition: all var(--duration-fast) var(--ease-premium);
}
.site-footer__social-link:hover {
  background-color: var(--color-gold-500);
  color: var(--color-navy-950);
  border-color: var(--color-gold-500);
}

/* Headings */
.site-footer__heading {
  font-family: var(--font-sans);
  font-size: var(--text-eyebrow);
  letter-spacing: var(--tracking-eyebrow);
  color: var(--color-gold-500);
  margin-bottom: var(--space-stack-md);
}

/* Links List */
.site-footer__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.site-footer__link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  text-decoration: none;
  color: var(--color-text-on-dark);
  font-size: var(--text-small);
  transition: color var(--duration-fast) var(--ease-premium);
  opacity: 0.8;
}
.site-footer__link svg {
  color: var(--color-gold-500);
  transition: transform var(--duration-fast) var(--ease-premium);
}
.site-footer__link:hover {
  color: var(--color-gold-400);
  opacity: 1;
}
.site-footer__link:hover svg {
  transform: translateX(4px);
}

/* Contact List */
.site-footer__contact-list {
  list-style: none;
  padding: 0;
  margin: 0 0 var(--space-stack-md) 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.site-footer__contact-list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
}
.site-footer__contact-icon {
  color: var(--color-gold-500);
  flex-shrink: 0;
  margin-top: 0.125rem;
}
.site-footer__contact-text,
.site-footer__contact-link {
  font-size: var(--text-small);
  color: var(--color-text-on-dark);
  opacity: 0.8;
  display: flex;
  flex-direction: column;
}
.site-footer__contact-link {
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease-premium);
}
.site-footer__contact-link:hover {
  color: var(--color-gold-400);
  opacity: 1;
}

/* Newsletter */
.site-footer__newsletter-text {
  font-size: var(--text-small);
  color: var(--color-text-on-dark);
  opacity: 0.8;
  margin-bottom: var(--space-stack-md);
}
.site-footer__form {
  display: flex;
  position: relative;
  margin-bottom: var(--space-stack-lg);
}
.site-footer__input {
  width: 100%;
  background-color: transparent;
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-sm);
  padding: 0.75rem 3rem 0.75rem 1rem;
  color: var(--color-cream-50);
  font-family: var(--font-sans);
  font-size: var(--text-small);
  transition: border-color var(--duration-fast) var(--ease-premium);
}
.site-footer__input:focus {
  outline: none;
  border-color: var(--color-gold-500);
}
.site-footer__input::placeholder {
  color: rgba(246, 241, 231, 0.4);
}
.site-footer__submit {
  position: absolute;
  right: 0.25rem;
  top: 0.25rem;
  bottom: 0.25rem;
  width: 2.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: var(--color-gold-500);
  color: var(--color-navy-950);
  border: none;
  border-radius: calc(var(--radius-sm) - 2px);
  cursor: pointer;
  transition: background-color var(--duration-fast) var(--ease-premium);
}
.site-footer__submit:hover {
  background-color: var(--color-gold-400);
}

.site-footer__trust {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: var(--color-gold-500);
}
.site-footer__trust-text {
  font-size: var(--text-tiny);
  color: var(--color-cream-100);
  opacity: 0.8;
}

.site-footer__form-status {
  min-height: 1.5rem;
  margin: 0.5rem 0 0;
  font-size: var(--text-tiny);
  color: var(--color-gold-400);
}

.site-footer__form-status.is-error {
  color: #e08b8b;
}

/* Schrader Web credit bar */
.schrader-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem clamp(1rem, 3.5vw, 5rem);
  background-color: #040d17;
  color: rgba(246, 241, 231, 0.55);
  font-family: var(--font-sans);
  font-size: calc(var(--text-tiny) * 1.3);
  text-align: center;
}

.schrader-bar__divider {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background-color: rgba(198, 146, 61, 0.6);
  flex-shrink: 0;
}

.schrader-bar a {
  color: rgba(246, 241, 231, 0.8);
  text-decoration: none;
  transition: color var(--duration-fast) var(--ease-premium);
}

.schrader-bar__legal {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
}

.schrader-bar a:hover,
.schrader-bar a:focus-visible {
  color: var(--color-gold-400);
  text-decoration: underline;
  text-underline-offset: 3px;
}
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
  const status = document.querySelector<HTMLElement>("[data-newsletter-status]");
  if (form && status) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const input = form.querySelector<HTMLInputElement>('input[type="email"]');
      const value = input?.value.trim() ?? "";
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      if (!emailOk) {
        status.textContent = "Please enter a valid email address.";
        status.classList.add("is-error");
        input?.focus();
        return;
      }
      status.classList.remove("is-error");
      status.textContent = "Thanks for subscribing! We'll be in touch.";
      form.reset();
    });
  }
</script>
