---
import ReviewCarousel from "@/components/shared/ui/ReviewCarousel.astro";
import Icon from "@/components/shared/ui/Icon.astro";
import { reviewSummary, reviews } from "@/data/reviews";
---

<section class="reviews-trust-section" id="reviews" aria-labelledby="reviews-title">
  <div class="site-container">
    <div class="section-header">
      <span class="section-eyebrow">REVIEWS &amp; TRUST</span>
      <h2 id="reviews-title">What Our Customers Say</h2>
      <div class="header-divider" aria-hidden="true"></div>
      <p class="review-summary">
        <span class="review-score">{reviewSummary.rating.toFixed(1)}</span>
        <span class="review-stars" aria-hidden="true">★★★★★</span>
        <span class="review-count">Average rating from <strong>{reviewSummary.count} {reviewSummary.source} reviews</strong></span>
        <a href={reviewSummary.url} target="_blank" rel="noopener noreferrer">
          Read all reviews
          <Icon name="arrow-up-right" size={15} strokeWidth={1.75} />
        </a>
      </p>
    </div>

    <div class="carousel-container">
      <ReviewCarousel reviews={reviews} />
    </div>
  </div>
</section>

<style>
  .reviews-trust-section {
    background-color: var(--color-cream-50);
    padding-block: clamp(2.5rem, 3.5vw, 4.5rem);
    position: relative;
  }

  .reviews-trust-section::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.02;
    /* Basic subtle noise pattern */
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    z-index: 0;
  }

  .site-container {
    position: relative;
    z-index: 1;
  }

  .section-header {
    text-align: center;
    margin-bottom: clamp(1.5rem, 2.5vw, 2.25rem);
  }

  .section-eyebrow {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-gold-500);
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    line-height: 1;
    text-transform: uppercase;
  }

  .section-header h2 {
    font-family: var(--font-display);
    color: var(--color-navy-950);
    font-size: clamp(2rem, 3vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin: 0;
  }

  .header-divider {
    width: 60px;
    height: 1px;
    background-color: var(--color-gold-500);
    margin: 1rem auto 0;
  }

  .review-summary {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    margin: 1.5rem auto 0;
    color: var(--color-text-secondary);
    font-size: var(--text-small);
  }

  .review-score {
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1;
  }

  .review-stars {
    color: var(--color-gold-500);
    letter-spacing: 0.12em;
    line-height: 1;
  }

  .review-summary strong {
    color: var(--color-navy-950);
    font-weight: 700;
  }

  .review-summary .review-count {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .review-count::after {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold-500);
    margin-left: 0.15rem;
  }

  .review-summary a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-water-700);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--color-gold-400);
    text-underline-offset: 0.25em;
    transition: color var(--duration-fast) var(--ease-premium);
  }

  .review-summary a:hover {
    color: var(--color-gold-700);
  }
</style>
