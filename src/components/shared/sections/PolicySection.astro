---
interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<section class="policy-section">
  <div class="site-container policy-container">
    <header class="policy-header">
      <span class="policy-eyebrow">LEGAL</span>
      <h1 class="policy-title">{title}</h1>
      <p class="policy-updated">Last updated: {updated}</p>
      <div class="policy-divider" aria-hidden="true"></div>
    </header>
    <div class="policy-body">
      <slot />
    </div>
  </div>
</section>

<style>
  .policy-section {
    background: var(--color-cream-50);
    color: var(--color-text-primary);
    padding-block: clamp(3.5rem, 6vw, 6rem);
  }

  .policy-container {
    max-width: var(--container-md);
  }

  .policy-header {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
    text-align: center;
  }

  .policy-eyebrow {
    display: block;
    margin-bottom: 1rem;
    color: var(--color-gold-600);
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .policy-title {
    margin: 0 0 1rem;
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.35rem + 2.4vw, 3.5rem);
    font-weight: 400;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .policy-updated {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-text-muted);
  }

  .policy-divider {
    width: 4rem;
    height: 1px;
    margin: 1.5rem auto 0;
    background-color: var(--color-gold-500);
  }

  .policy-body {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 2.5vw, 2rem);
  }

  .policy-body :global(h2) {
    margin: 0 0 0.75rem;
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .policy-body :global(h3) {
    margin: 0 0 0.5rem;
    color: var(--color-navy-900);
    font-family: var(--font-sans);
    font-size: var(--text-h4);
    font-weight: 600;
    line-height: 1.3;
  }

  .policy-body :global(p) {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    line-height: 1.75;
    color: var(--color-text-secondary);
  }

  .policy-body :global(ul) {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .policy-body :global(a) {
    color: var(--color-gold-700);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-gold-400);
    text-underline-offset: 0.2em;
  }

  .policy-body :global(.policy-block) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
</style>