---
import { Image } from "astro:assets";
import Icon from "@/components/shared/ui/Icon.astro";
import GoldLine from "@/components/shared/ui/GoldLine.astro";
import googleReviews from "@/assets/reviews/google-review.webp";
import facebookReviews from "@/assets/reviews/fb-review.webp";
import { site } from "@/data/site";
---
<section class="review-cta">
  <div class="review-cta__container">
    <div class="review-cta__header">
      <Icon name="anchor" class="review-cta__icon" size={24} />
      <span class="review-cta__eyebrow">WE VALUE YOUR FEEDBACK</span>
    </div>
    
    <h2 class="review-cta__title">
      Please leave a review for us on <span class="review-cta__highlight">Google</span> or <span class="review-cta__highlight">Facebook</span>
    </h2>
    
    <div class="review-cta__divider-wrapper">
      <GoldLine />
    </div>
    
    <div class="review-cta__badges">
      <a href={site.googleReviewUrl} target="_blank" rel="noopener noreferrer" class="review-cta__badge" aria-label="Review us on Google">
        <Image src={googleReviews} alt="Review us on Google" />
      </a>
      <a href={site.facebookReviewUrl} target="_blank" rel="noopener noreferrer" class="review-cta__badge" aria-label="Review us on Facebook">
        <Image src={facebookReviews} alt="Review us on Facebook" />
      </a>
    </div>
  </div>
</section>

<style>
.review-cta {
  background-color: var(--color-cream-50);
  padding-block: clamp(4rem, 5vw, 7rem);
  text-align: center;
}
.review-cta__container {
  width: min(calc(100% - 2 * var(--container-gutter)), var(--container-md));
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.review-cta__header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  margin-bottom: var(--space-stack-md);
  color: var(--color-gold-500);
}
.review-cta__eyebrow {
  font-family: var(--font-sans);
  font-size: var(--text-eyebrow);
  letter-spacing: var(--tracking-eyebrow);
  text-transform: uppercase;
  font-weight: 700;
}
.review-cta__title {
  font-family: var(--font-display);
  font-size: var(--text-h2);
  color: var(--color-navy-950);
  line-height: var(--leading-heading);
  margin-bottom: var(--space-stack-md);
}
.review-cta__highlight {
  color: var(--color-water-600);
}
.review-cta__divider-wrapper {
  margin-bottom: var(--space-stack-lg);
  display: flex;
  justify-content: center;
  width: 100%;
}
.review-cta__badges {
  display: flex;
  gap: clamp(1rem, 4vw, 3rem);
  flex-wrap: wrap;
  justify-content: center;
}
.review-cta__badge {
  display: block;
  transition: transform var(--duration-fast) var(--ease-premium);
}
.review-cta__badge:hover {
  transform: scale(1.05);
}
.review-cta__badge img {
  width: clamp(140px, 20vw, 220px);
  height: auto;
  object-fit: contain;
}
</style>
