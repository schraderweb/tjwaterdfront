---
import { Image } from "astro:assets";
import Icon from "@/components/shared/ui/Icon.astro";

export interface ProductCardItem {
  title: string;
  subtitle?: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  href: string;
  badge?: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  cards: [ProductCardItem, ProductCardItem];
}

const { eyebrow, title, description, cards } = Astro.props;
---

<section class="dual-cards-section" aria-label={title ?? "Featured Systems"}>
  <div class="site-container">
    {
      (eyebrow || title || description) && (
        <div class="section-header">
          {eyebrow && <span class="eyebrow">{eyebrow}</span>}
          {title && <h2 class="section-title">{title}</h2>}
          {description && <p class="section-desc">{description}</p>}
        </div>
      )
    }

    <div class="cards-grid">
      {
        cards.map((card) => (
          <a href={card.href} class="product-card group" aria-label={`Explore ${card.title}`}>
            <div class="card-media">
              <Image
                src={card.image}
                alt={card.imageAlt}
                width={1000}
                height={650}
                class="card-img"
              />
              <div class="card-overlay" />
            </div>

            <div class="card-content">
              {card.badge && <span class="card-badge">{card.badge}</span>}
              <div class="card-headings">
                <h3 class="card-title">{card.title}</h3>
                {card.subtitle && <p class="card-subtitle">{card.subtitle}</p>}
              </div>
              <p class="card-body">{card.body ?? card.description}</p>
              <div class="card-action">
                <span class="action-text">Explore {card.title}</span>
                <span class="action-arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={18} strokeWidth={2} />
                </span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .dual-cards-section {
    background: var(--color-cream-50, #fcfaf5);
    padding-block: clamp(3.5rem, 5vw, 5.5rem);
    border-bottom: 1px solid rgba(7, 26, 43, 0.08);
  }

  .section-header {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto clamp(2rem, 3.5vw, 3rem);
  }

  .eyebrow {
    display: inline-block;
    color: var(--color-gold-600, #b98232);
    font-size: var(--text-tiny, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    color: var(--color-navy-950, #041525);
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }

  .section-desc {
    color: var(--color-text-secondary, #4a5568);
    font-size: clamp(1rem, 1.2vw, 1.125rem);
    line-height: 1.6;
    margin: 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: clamp(24rem, 36vw, 30rem);
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    text-decoration: none;
    background: var(--color-navy-950, #071a2d);
    box-shadow: 0 10px 30px -10px rgba(7, 26, 43, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: transform 400ms var(--ease-premium, cubic-bezier(0.16, 1, 0.3, 1)),
      box-shadow 400ms var(--ease-premium, cubic-bezier(0.16, 1, 0.3, 1)),
      border-color 400ms var(--ease-premium, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .product-card:hover,
  .product-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -15px rgba(7, 26, 43, 0.38);
    border-color: rgba(198, 146, 61, 0.6);
  }

  .card-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-premium, cubic-bezier(0.16, 1, 0.3, 1));
  }

  .product-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(4, 21, 37, 0.95) 0%,
      rgba(4, 21, 37, 0.72) 45%,
      rgba(4, 21, 37, 0.25) 80%,
      rgba(4, 21, 37, 0.1) 100%
    );
    transition: opacity 400ms var(--ease-premium);
  }

  .product-card:hover .card-overlay {
    opacity: 0.92;
  }

  .card-content {
    position: relative;
    z-index: 2;
    padding: clamp(1.5rem, 2.5vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: var(--color-white, #ffffff);
  }

  .card-badge {
    align-self: flex-start;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: rgba(198, 146, 61, 0.25);
    border: 1px solid rgba(198, 146, 61, 0.7);
    color: var(--color-gold-300, #edd49a);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-headings {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    color: var(--color-white, #ffffff);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .card-subtitle {
    margin: 0;
    color: var(--color-gold-300, #edd49a);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .card-body {
    margin: 0;
    color: rgba(246, 241, 231, 0.88);
    font-size: clamp(0.9rem, 1vw, 1rem);
    line-height: 1.5;
    max-width: 48ch;
  }

  .card-action {
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-gold-400, #dfb15b);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    transition: gap 300ms var(--ease-premium), color 300ms var(--ease-premium);
  }

  .product-card:hover .card-action {
    color: var(--color-white);
    gap: 0.75rem;
  }

  .action-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: rgba(198, 146, 61, 0.25);
    transition: transform 300ms var(--ease-premium), background-color 300ms var(--ease-premium);
  }

  .product-card:hover .action-arrow {
    transform: translateX(4px);
    background: var(--color-gold-500);
    color: var(--color-navy-950);
  }

  @media (max-width: 768px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }

    .product-card {
      min-height: 22rem;
    }
  }
</style>
