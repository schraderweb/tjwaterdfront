---
/**
 * SubmitSuccess.astro — minimal thank-you panel with an inline SVG scene:
 * gold ring, drifting water waves, bobbing boat, drawn checkmark.
 * Hidden by default; revealed + animated by initSubmitSuccess() (submit-success.js).
 * Reduced-motion users get a static, instantly-visible panel.
 */
interface Props {
  title?: string;
  message?: string;
  variant?: "light" | "dark";
  resetLabel?: string;
  class?: string;
}

const {
  title = "Thank You",
  message = "We've received your enquiry — our team will be in touch within one business day.",
  variant = "light",
  resetLabel = "Send another enquiry",
  class: className,
} = Astro.props;

const isDark = variant === "dark";
---

<div
  class:list={["submit-success", isDark && "submit-success--dark", className]}
  data-success-panel
  role="status"
  aria-live="polite"
  tabindex="-1"
  hidden
>
  <div class="submit-success__scene" aria-hidden="true">
    <svg viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle data-success-ring class="ring" cx="60" cy="60" r="50" />
      <circle data-success-ring-dots class="ring-dots" cx="60" cy="60" r="42" />
      <path
        data-success-wave
        class="wave wave--back"
        d="M25 91 C 30 87, 35 95, 40 91 S 50 87, 55 91 S 65 95, 70 91 S 80 87, 85 91 S 95 95, 100 91"
      />
      <path
        data-success-wave
        class="wave wave--front"
        d="M32 100 C 36 96, 40 104, 44 100 S 52 96, 56 100 S 64 104, 68 100 S 76 96, 80 100 S 88 104, 92 100"
      />
      <g data-success-boat class="boat">
        <path class="boat__mast" d="M60 68 L60 79" />
        <path class="boat__sail" d="M60 68 L68 74 L60 74 Z" />
        <path class="boat__hull" d="M49 79 H71 L67 85 H53 Z" />
      </g>
      <path data-success-check class="check" d="M43 53 L54 64 L77 39" />
    </svg>
  </div>

  <h3 class="submit-success__title">{title}</h3>
  <div class="submit-success__line" aria-hidden="true"></div>
  <p class="submit-success__message">{message}</p>
  <button type="button" class="submit-success__reset" data-success-reset>
    {resetLabel}
  </button>
</div>

<style>
  .submit-success {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    min-height: 20rem;
    padding: 2rem 1.5rem;
    color: var(--color-navy-950);
    outline: none;
  }

  .submit-success--dark {
    color: var(--color-cream-50);
    background: linear-gradient(145deg, rgba(7, 26, 43, 0.86), rgba(11, 34, 54, 0.94));
    border: 1px solid rgba(217, 174, 98, 0.32);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .submit-success__scene {
    width: clamp(5.5rem, 6rem + 2vw, 7.5rem);
  }

  .submit-success__scene svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .ring {
    stroke: var(--color-gold-500);
    stroke-width: 1.5;
  }

  .ring-dots {
    stroke: var(--color-gold-500);
    stroke-width: 1;
    stroke-dasharray: 1 7;
    stroke-linecap: round;
    opacity: 0.35;
  }

  .wave--back {
    stroke: var(--color-water-600);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.65;
  }

  .wave--front {
    stroke: var(--color-navy-800);
    stroke-width: 1.75;
    stroke-linecap: round;
    opacity: 0.9;
  }

  .submit-success--dark .wave--back {
    stroke: var(--color-water-200);
  }

  .submit-success--dark .wave--front {
    stroke: var(--color-cream-200);
  }

  .boat__hull {
    fill: var(--color-navy-900);
  }

  .boat__mast {
    stroke: var(--color-gold-500);
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .boat__sail {
    fill: var(--color-gold-500);
    opacity: 0.8;
  }

  .submit-success--dark .boat__hull {
    fill: var(--color-cream-100);
  }

  .check {
    stroke: var(--color-gold-500);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .submit-success--dark .check {
    stroke: var(--color-gold-400);
  }

  .submit-success__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .submit-success--dark .submit-success__title {
    color: var(--color-cream-50);
  }

  .submit-success__line {
    width: 3.25rem;
    height: 1px;
    background-color: var(--color-gold-500);
    opacity: 0.6;
  }

  .submit-success__message {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-navy-800);
  }

  .submit-success--dark .submit-success__message {
    color: var(--color-cream-200);
  }

  .submit-success__reset {
    margin-top: 0.75rem;
    padding: 0.5rem 1rem;
    background: transparent;
    border: 1px solid rgba(16, 34, 53, 0.25);
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-navy-800);
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-premium),
      color var(--duration-fast) var(--ease-premium);
  }

  .submit-success__reset:hover,
  .submit-success__reset:focus-visible {
    border-color: var(--color-gold-500);
    color: var(--color-gold-600);
    outline: none;
  }

  .submit-success--dark .submit-success__reset {
    border-color: rgba(246, 241, 231, 0.3);
    color: var(--color-cream-200);
  }

  .submit-success--dark .submit-success__reset:hover,
  .submit-success--dark .submit-success__reset:focus-visible {
    border-color: var(--color-gold-400);
    color: var(--color-gold-400);
  }
</style>
