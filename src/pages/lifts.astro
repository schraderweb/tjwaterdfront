---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import HubGrid from "@/components/shared/sections/HubGrid.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import { liftsCards } from "@/data/hubCards";

import heroImage from "@/content/gallery/hoist-service-repairs/01.webp";
---

<BaseLayout title="Lifts | T&J Waterfront Services">
  <Navbar />

  <main id="main">
    <InteriorHero
      title="Lifts"
      description="Boat and pontoon lifts, PWC lifts, canopies, and accessories — launching made effortless."
      image={heroImage}
      imageAlt="Boat lifts by T&J Waterfront Services"
    />

    <HubGrid
      eyebrow="LIFTS"
      title="Lifts & Accessories"
      description="Explore our lift systems and accessories to find the right setup for your watercraft."
      services={liftsCards}
    />

    <PopularServices />

    <ReviewsTrustSection topFill="var(--color-cream-50)" bottomFill="var(--color-navy-950)" />

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>
