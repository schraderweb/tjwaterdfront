---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import HubGrid from "@/components/shared/sections/HubGrid.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import { docksCards } from "@/data/hubCards";

import heroImage from "@/content/gallery/dock-service-repairs/02.webp";
---

<BaseLayout title="Docks | T&J Waterfront Services">
  <Navbar />

  <main id="main">
    <InteriorHero
      title="Docks"
      description="Sectional, roll-in, platinum, and floating dock systems — plus the accessories that complete them."
      image={heroImage}
      imageAlt="Dock systems by T&J Waterfront Services"
    />

    <HubGrid
      eyebrow="DOCKS"
      title="Dock Systems"
      description="Explore our dock systems and find the right fit for your shoreline."
      services={docksCards}
    />

    <PopularServices />

    <ReviewsTrustSection topFill="var(--color-cream-50)" bottomFill="var(--color-navy-950)" />

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>
