---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import GallerySection from "@/components/shared/sections/GallerySection.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import Button from "@/components/shared/ui/Button.astro";
import Icon from "@/components/shared/ui/Icon.astro";

import heroImage from "@/assets/services/connect-a-dock.webp";
---

<BaseLayout title="Connect A Dock Floating Dock Systems | T&J Waterfront Services">
  <Navbar />

  <main id="main">
    <InteriorHero
      title="Connect A Dock"
      description="Modular, family-friendly floating dock systems engineered for easy configuration, extreme durability, and effortless waterfront enjoyment."
      image={heroImage}
      imageAlt="Connect A Dock floating dock system installation in Michigan"
    />

    <section class="overview-section">
      <div class="site-container">
        <div class="overview-grid">
          <div class="overview-content">
            <span class="section-eyebrow">MODULAR FLOATING SYSTEMS</span>
            <h2 class="section-heading">Swimming, Boating & Fishing</h2>
            <p class="lead-text">
              A lifetime of waterfront adventures awaits with the family-friendly Connect-A-Dock floating dock system. 
              Modular design and rugged construction allow a simple, quick, and reliable way to build boat docks, rowing docks, 
              fishing docks, swimming platforms, and anything else you can imagine at home, in parks, and at resorts.
            </p>
            <p class="body-text">
              A Connect-A-Dock floating dock system helps create countless family memories of safe and enjoyable fun on the water. 
              Its unique connection system allows you to configure and reconfigure the layout in an unlimited variety of shapes 
              to suit your shoreline and watercraft needs.
            </p>
            <div class="cta-row">
              <Button href="/contact" variant="gold" size="lg">Get a Quote</Button>
              <Button href="tel:+15172945577" variant="navy" size="lg">Call 517-294-5577</Button>
            </div>
          </div>

          <div class="series-cards">
            <div class="series-card">
              <div class="series-header">
                <span class="series-badge">Low Profile</span>
                <h3>1000 Series Floating Dock</h3>
              </div>
              <p>
                Providing the ultimate flexibility in configuration, simple installation, and extreme durability, 
                the 1000 Series-LowProfile Connect-A-Dock series is the logical choice for extending your waterfront enjoyment. 
                Ideal for paddlecraft, swimming platforms, rowing, and small fishing boats.
              </p>
              <ul class="series-bullets">
                <li><Icon name="check" size={18} /> 8" (20.3 cm) freeboard</li>
                <li><Icon name="check" size={18} /> Skid-resistant wood grain texture</li>
                <li><Icon name="check" size={18} /> Modular connection system for flexible shapes</li>
                <li><Icon name="check" size={18} /> UV-protected rotationally molded polyethylene</li>
              </ul>
            </div>

            <div class="series-card is-featured">
              <div class="series-header">
                <span class="series-badge badge-gold">High Profile</span>
                <h3>2000 Series Floating Dock</h3>
              </div>
              <p>
                With its 17" (43.2 cm) freeboard, the 2000 Series Connect-A-Dock system is best suited for floating marinas, 
                sailing clubs, launch docks, fishing piers, and mooring power boats such as ski boats, pontoon boats, sailboats, 
                and catamarans — providing an even transition when boarding.
              </p>
              <ul class="series-bullets">
                <li><Icon name="check" size={18} /> 17" (43.2 cm) freeboard for larger craft</li>
                <li><Icon name="check" size={18} /> Heavy-duty load capacity</li>
                <li><Icon name="check" size={18} /> Easy walk-on stability in all lake conditions</li>
                <li><Icon name="check" size={18} /> Connects to fixed docks or shore walkways</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Video Showcase Section -->
    <section class="video-showcase-section">
      <div class="site-container">
        <div class="section-header text-center">
          <span class="section-eyebrow">SEE IT IN ACTION</span>
          <h2 class="section-heading">Connect-A-Dock & Accessories in Action</h2>
          <p class="section-subheading">Watch how easily Connect-A-Dock systems and PWC drive-on docking operate on Michigan lakes.</p>
        </div>

        <div class="videos-grid">
          <div class="video-card">
            <div class="video-wrapper">
              <iframe
                src="https://www.youtube-nocookie.com/embed/NHK_5JrlBbA"
                title="Connect A Dock Floating Dock & PWC Drive On"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="video-meta">
              <h4>Connect A Dock Floating Dock & PWC Drive On</h4>
              <p>See the modular dock transition and drive-on personal watercraft port in real lake conditions.</p>
            </div>
          </div>

          <div class="video-card">
            <div class="video-wrapper">
              <iframe
                src="https://www.youtube-nocookie.com/embed/YDHxdzW7CIU"
                title="Connect A Port XL6 - PWC Docking"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="video-meta">
              <h4>Connect A Port XL6 — PWC Docking</h4>
              <p>Walkaround and drive-on demonstration with Stoltz rollers for smooth launching and retrieval.</p>
            </div>
          </div>

          <div class="video-card">
            <div class="video-wrapper">
              <iframe
                src="https://www.youtube-nocookie.com/embed/l1WwnbsubnY"
                title="YAKport Kayak Launch"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>
            <div class="video-meta">
              <h4>YAKport Kayak Launch</h4>
              <p>Safe and accessible entry and launch for kayaks and canoes connected directly to your dock.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <GallerySection category="floating-dock" />

    <PopularServices />

    <ReviewsTrustSection topFill="var(--color-cream-50)" bottomFill="var(--color-navy-950)" />

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .overview-section {
    padding-block: clamp(4rem, 6vw, 6.5rem);
    background: var(--color-white, #ffffff);
  }

  .overview-section > .site-container {
    max-width: clamp(75rem, 85vw, 86rem);
    margin-inline: auto;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2.5rem, 4vw, 5rem);
    align-items: start;
  }

  .section-eyebrow {
    display: inline-block;
    color: var(--color-gold-600, #b98232);
    font-size: clamp(0.8125rem, 0.78rem + 0.2vw, 0.9375rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3.25rem);
    color: var(--color-navy-950, #041525);
    line-height: 1.15;
    margin: 0 0 1.35rem;
  }

  .lead-text {
    font-size: clamp(1.15rem, 1.05rem + 0.35vw, 1.35rem);
    line-height: 1.65;
    color: var(--color-navy-900, #071a2d);
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .body-text {
    font-size: clamp(1.05rem, 0.98rem + 0.25vw, 1.1875rem);
    line-height: 1.7;
    color: var(--color-text-secondary, #4a5568);
    margin-bottom: 2.25rem;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .series-cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .series-card {
    padding: clamp(1.75rem, 2.25vw, 2.5rem);
    border-radius: var(--radius-md, 12px);
    background: var(--color-cream-50, #fcfaf5);
    border: 1px solid var(--color-border-light, #e2e8f0);
    box-shadow: 0 4px 15px -3px rgba(7, 26, 43, 0.06);
  }

  .series-card.is-featured {
    border-color: rgba(198, 146, 61, 0.5);
    background: linear-gradient(135deg, rgba(252, 250, 245, 1) 0%, rgba(246, 241, 231, 0.9) 100%);
  }

  .series-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .series-header h3 {
    font-family: var(--font-sans);
    font-size: clamp(1.35rem, 1.2rem + 0.4vw, 1.6rem);
    font-weight: 700;
    color: var(--color-navy-950, #041525);
    margin: 0;
  }

  .series-badge {
    padding: 0;
    background: transparent;
    color: var(--color-navy-800, #071a2d);
    font-size: clamp(0.8rem, 0.76rem + 0.15vw, 0.9rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .series-badge::before {
    content: "";
    display: inline-block;
    width: 0.65rem;
    height: 1.5px;
    background: currentColor;
  }

  .series-badge.badge-gold {
    background: transparent;
    color: var(--color-gold-600, #966b1a);
  }

  .series-card p {
    font-size: clamp(1.025rem, 0.96rem + 0.2vw, 1.15rem);
    line-height: 1.65;
    color: var(--color-text-secondary, #4a5568);
    margin: 0 0 1.25rem;
  }

  .series-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .series-bullets li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: clamp(0.975rem, 0.92rem + 0.2vw, 1.075rem);
    font-weight: 600;
    color: var(--color-navy-900, #071a2d);
  }

  .series-bullets li :global(svg) {
    color: var(--color-gold-600, #b98232);
    flex-shrink: 0;
  }

  /* Video showcase */
  .video-showcase-section {
    padding-block: clamp(4rem, 6vw, 6rem);
    background: var(--color-navy-950, #041525);
    color: var(--color-white, #ffffff);
  }

  .video-showcase-section > .site-container {
    max-width: clamp(75rem, 85vw, 86rem);
    margin-inline: auto;
  }

  .section-header.text-center {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto clamp(2.5rem, 4vw, 3.5rem);
  }

  .section-header.text-center .section-heading {
    color: var(--color-white, #ffffff);
  }

  .section-subheading {
    color: rgba(246, 241, 231, 0.85);
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.2rem);
    line-height: 1.6;
    margin: 0;
  }

  .videos-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 2vw, 2rem);
  }

  .video-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
  }

  .video-wrapper {
    position: relative;
    padding-top: 56.25%;
    width: 100%;
    background: #000;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-meta {
    padding: 1.4rem;
  }

  .video-meta h4 {
    font-family: var(--font-sans);
    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.2rem);
    font-weight: 700;
    color: var(--color-white);
    margin: 0 0 0.5rem;
    line-height: 1.35;
  }

  .video-meta p {
    font-size: clamp(0.925rem, 0.88rem + 0.15vw, 1rem);
    line-height: 1.55;
    color: rgba(246, 241, 231, 0.8);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .overview-grid {
      grid-template-columns: 1fr;
    }
    .videos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
