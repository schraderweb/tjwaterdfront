---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import GallerySection from "@/components/shared/sections/GallerySection.astro";
import ContactAboutSection from "@/components/shared/sections/ContactAboutSection.astro";
import ProjectEnquirySection from "@/components/shared/sections/ProjectEnquirySection.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";

// Hero image
import heroImage from "@/assets/hero/contact-us.png";
---

<BaseLayout title="Contact Us | T&J Waterfront Services">
  <Navbar />

  <main id="main">
    <InteriorHero
      title="Contact Us"
      description="Ready to start your waterfront project? Call, email, or send us a message — we're here to help seven days a week."
      image={heroImage}
      imageAlt="Contact T&J Waterfront Services"
    />

    <ProjectEnquirySection />

    <ContactAboutSection />

    <GallerySection />

    <PopularServices />

    <ReviewsTrustSection topFill="var(--color-cream-50)" bottomFill="var(--color-navy-950)" />

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>
