---
/**
 * 404.astro — custom page-not-found page.
 * Body area features a looping background video clip (public/404.mp4)
 * with a poster/fallback so the page still looks intentional without it.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import Button from "@/components/shared/ui/Button.astro";
import Icon from "@/components/shared/ui/Icon.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title="Page Not Found | T&J Waterfront Services"
  description="The page you are looking for could not be found. Explore our waterfront services or contact T&J Waterfront Services."
  canonicalPath="/404"
>
  <Navbar />

  <main id="main">
    <section class="not-found" aria-labelledby="not-found-title">
      <div class="video-area" aria-hidden="true">
        <img
          src="/404-clip.webp"
          alt=""
          class="bg-video"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="not-found-content">
        <Icon name="anchor" size={40} strokeWidth={1.2} class="not-found-icon" />
        <p class="not-found-eyebrow">ERROR 404</p>
        <h1 id="not-found-title" class="not-found-title">Page Not Found</h1>
        <p class="not-found-text">
          The page you are looking for doesn't exist, was moved, or is
          temporarily unavailable. Let's get you back to the water.
        </p>
        <div class="not-found-actions">
          <Button href="/" variant="gold" size="lg">Back To Home</Button>
          <Button href="/contact" variant="navy" size="lg">Contact Us</Button>
        </div>
        <p class="not-found-help">
          Or call us directly at <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .not-found {
    position: relative;
    min-height: calc(100svh - 8rem);
    display: grid;
    place-items: center;
    overflow: hidden;
    background-color: var(--color-navy-950);
    color: var(--color-cream-50);
    padding: clamp(4rem, 8vw, 7rem) var(--container-gutter);
  }

  .video-area {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .bg-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .not-found-content {
    position: relative;
    z-index: 2;
    max-width: 46rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .not-found-icon {
    color: var(--color-gold-500);
    margin-bottom: 1.5rem;
  }

  .not-found-eyebrow {
    margin: 0 0 1rem;
    color: var(--color-gold-400);
    font-family: var(--font-sans);
    font-size: var(--text-eyebrow);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
  }

  .not-found-title {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-size: clamp(3rem, 2rem + 5vw, 6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--tracking-heading);
  }

  .not-found-text {
    margin: 0 0 2.5rem;
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 1.05rem + 0.35vw, 1.3rem);
    line-height: 1.7;
    color: rgba(246, 241, 231, 0.85);
    max-width: 38rem;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .not-found-help {
    margin: 2rem 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: rgba(246, 241, 231, 0.7);
  }

  .not-found-help a {
    color: var(--color-gold-400);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: rgba(198, 146, 61, 0.55);
    text-underline-offset: 0.2em;
  }
</style>