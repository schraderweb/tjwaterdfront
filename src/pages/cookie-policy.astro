---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import PolicySection from "@/components/shared/sections/PolicySection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import { site } from "@/data/site";
---

<BaseLayout
  title="Cookie Policy | T&J Waterfront Services"
  description="How T&J Waterfront Services uses cookies and similar technologies on its website."
  canonicalPath="/cookie-policy"
>
  <Navbar />

  <main id="main">
    <PolicySection title="Cookie Policy" updated="August 23, 2026">
      <div class="policy-block">
        <h2>What Are Cookies?</h2>
        <p>
          Cookies are small text files stored on your device when you visit a
          website. They help the website function properly, remember your
          preferences, and provide information to site owners about how
          visitors use the site.
        </p>
      </div>

      <div class="policy-block">
        <h2>How We Use Cookies</h2>
        <p>We use cookies and similar technologies for the following purposes:</p>
        <ul>
          <li>
            <strong>Essential cookies</strong> — required for the website to
            function correctly, such as maintaining session state.
          </li>
          <li>
            <strong>Analytics cookies</strong> — help us understand how
            visitors interact with our website so we can improve it.
          </li>
          <li>
            <strong>Marketing cookies</strong> — used to deliver relevant
            advertisements and measure the effectiveness of our marketing.
            This includes the Facebook (Meta) Pixel, which helps us show
            advertising to people who have visited our website.
          </li>
        </ul>
      </div>

      <div class="policy-block">
        <h2>Third-Party Cookies</h2>
        <p>
          Some cookies are set by third-party services we use, including Meta
          (Facebook), which may set cookies when the Facebook Pixel is active
          on our site. These third parties may use cookies to build profiles of
          your interests and show you relevant ads on other websites. To learn
          more about how Meta uses your information, please review Meta's
          Privacy Policy at{" "}
          <a
            href="https://www.facebook.com/policy.php"
            target="_blank"
            rel="noopener noreferrer"
            >https://www.facebook.com/policy.php</a
          >.
        </p>
      </div>

      <div class="policy-block">
        <h2>Managing Cookies</h2>
        <p>
          You can control and delete cookies through your browser settings.
          Most browsers allow you to block or remove cookies, and you can
          opt out of interest-based advertising through tools such as
          Meta's ad preferences. Please note that disabling some cookies may
          affect the functionality of our website.
        </p>
        <ul>
          <li>
            <strong>Google Chrome:</strong> Settings &rarr; Privacy and
            security &rarr; Cookies
          </li>
          <li>
            <strong>Mozilla Firefox:</strong> Options &rarr; Privacy &amp;
            Security &rarr; Cookies and Site Data
          </li>
          <li>
            <strong>Safari:</strong> Preferences &rarr; Privacy &rarr;
            Manage Website Data
          </li>
          <li>
            <strong>Microsoft Edge:</strong> Settings &rarr; Cookies and site
            permissions
          </li>
        </ul>
      </div>

      <div class="policy-block">
        <h2>Changes to This Policy</h2>
        <p>
          We may update this Cookie Policy from time to time. Any changes will
          be posted on this page with an updated "Last updated" date.
        </p>
      </div>

      <div class="policy-block">
        <h2>Contact Us</h2>
        <p>
          If you have any questions about our use of cookies, please contact us
          at <a href={`mailto:${site.email}`}>{site.email}</a> or call{" "}
          <a href={site.phoneHref}>{site.phoneDisplay}</a>.
        </p>
      </div>
    </PolicySection>
  </main>

  <SiteFooter />
</BaseLayout>