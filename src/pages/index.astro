---
/**
 * Home page — hero, Section 2 service showcase, and Popular Services (Section 3).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import Hero from "@/components/pages/home/hero/Hero.astro";
import FeaturedServices from "@/components/pages/home/sections/FeaturedServices.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import PromotionalResourcesSection from "@/components/pages/home/sections/PromotionalResourcesSection.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ReviewCTA from "@/components/shared/sections/ReviewCTA.astro";
import LocationMap from "@/components/shared/sections/LocationMap.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
---

<BaseLayout>
  <Navbar />
  <main id="main">
    <Hero />
    <FeaturedServices />
    <PopularServices />
    <PromotionalResourcesSection />
    <ReviewsTrustSection />
    <ReviewCTA />
    <LocationMap />
  </main>
  <SiteFooter />
</BaseLayout>
