---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import GallerySection from "@/components/shared/sections/GallerySection.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import Button from "@/components/shared/ui/Button.astro";
import Icon from "@/components/shared/ui/Icon.astro";

import heroImage from "@/assets/services/starr-floating-dock.webp";
---

<BaseLayout title="Starr Floating Dock Systems | T&J Waterfront Services">
  <Navbar />

  <main id="main">
    <InteriorHero
      title="Starr Floating Dock"
      description="Heavy-gauge aluminum floating dock systems designed to maintain stability in deep water, adapt to changing lake levels, and excel over soft mucky bottoms."
      image={heroImage}
      imageAlt="Starr aluminum floating dock with pontoon boat on Michigan lake"
    />

    <!-- Problem-Solution Challenge Cards -->
    <section class="challenges-section">
      <div class="site-container">
        <div class="section-header text-center">
          <span class="section-eyebrow">ENGINEERED FOR CHALLENGING WATERFRONTS</span>
          <h2 class="section-heading">When is a Starr Floating Dock the Right Choice?</h2>
          <p class="section-subheading">
            Not every shoreline allows a standard standing dock. Starr aluminum floating docks solve Michigan's toughest lakefront conditions.
          </p>
        </div>

        <div class="challenges-grid">
          <div class="challenge-card">
            <div class="challenge-icon">
              <Icon name="anchor" size={28} />
            </div>
            <h3>Water Depths Greater Than 9 Feet?</h3>
            <p>
              Free-standing docks become unstable in deeper water, while a floating system maintains its stability. 
              Because the dock rests on the water's surface, it offers an exceptionally solid platform no matter how deep the drop-off is.
            </p>
          </div>

          <div class="challenge-card">
            <div class="challenge-icon">
              <Icon name="play" size={28} />
            </div>
            <h3>Significant Fluctuation in Lake Levels?</h3>
            <p>
              A floating dock automatically adjusts on its own as water levels rise and fall throughout the season. 
              Enjoy a level, consistent transition to your boat without needing constant manual height adjustments.
            </p>
          </div>

          <div class="challenge-card">
            <div class="challenge-icon">
              <Icon name="shield-check" size={28} />
            </div>
            <h3>Soft or Very Mucky Lake Bottom?</h3>
            <p>
              A floating dock is the ultimate solution for a mucky or soft lake bottom. Floating docks do not use the lake 
              bottom for vertical support, eliminating sinking legs and uneven docks.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Benefits & Specs Section -->
    <section class="benefits-section">
      <div class="site-container">
        <div class="benefits-grid">
          <div class="benefits-content">
            <span class="section-eyebrow">PREMIUM ADVANTAGES</span>
            <h2 class="section-heading">Starr Floating Dock Benefits</h2>
            <p class="lead-text">
              Engineered with heavy-gauge marine aluminum and commercial-grade flotation billets, Starr floating docks 
              are built to endure decades of Michigan lake seasons.
            </p>

            <ul class="benefits-list">
              <li>
                <span class="check-wrap"><Icon name="check" size={18} /></span>
                <div>
                  <strong>Adjusts to fluctuating water conditions</strong>
                  <span>Always sits at the correct height relative to your boat.</span>
                </div>
              </li>
              <li>
                <span class="check-wrap"><Icon name="check" size={18} /></span>
                <div>
                  <strong>Truss or Platinum Style Docks</strong>
                  <span>Available in rugged open-sided Truss or sleek, soft-edged Platinum profiles.</span>
                </div>
              </li>
              <li>
                <span class="check-wrap"><Icon name="check" size={18} /></span>
                <div>
                  <strong>Modular Design & Add-On Capability</strong>
                  <span>Easily expand or modify your dock layout as your waterfront needs grow.</span>
                </div>
              </li>
              <li>
                <span class="check-wrap"><Icon name="check" size={18} /></span>
                <div>
                  <strong>15-Year Manufacturer Warranty</strong>
                  <span>Backed by industry-leading quality assurance and long-term durability.</span>
                </div>
              </li>
              <li>
                <span class="check-wrap"><Icon name="check" size={18} /></span>
                <div>
                  <strong>Salt Water Safe & Corrosion Resistant</strong>
                  <span>Heavy-gauge marine aluminum stands up to weathering, UV, and wave energy.</span>
                </div>
              </li>
            </ul>

            <div class="cta-group">
              <Button href="/contact" variant="gold" size="lg">Get a Custom Quote</Button>
              <a
                href="https://starr-products.com/images/pdfs/2026-starr-docks-lifts.pdf#page=8"
                target="_blank"
                rel="noopener noreferrer"
                class="brochure-link"
              >
                <Icon name="briefcase" size={20} />
                Download Starr Marine Brochure (PDF)
              </a>
            </div>
          </div>

          <div class="specs-panel">
            <div class="panel-inner">
              <h3>Available Sizes & Configurations</h3>
              <p class="panel-lead">Standard sections and custom sundeck platforms available to build your layout:</p>

              <div class="size-group">
                <h4>Standard Floating Dock Sections</h4>
                <div class="size-tags">
                  <span class="size-tag">4' &times; 8'</span>
                  <span class="size-tag">4' &times; 12'</span>
                  <span class="size-tag">4' &times; 16'</span>
                </div>
              </div>

              <div class="size-group">
                <h4>Sundeck Platforms</h4>
                <div class="size-tags">
                  <span class="size-tag">8' &times; 8'</span>
                  <span class="size-tag">8' &times; 12'</span>
                  <span class="size-tag">8' &times; 16'</span>
                </div>
              </div>

              <div class="installation-note">
                <Icon name="wrench" size={20} />
                <p>
                  <strong>Professional Installation Included:</strong> T&J Waterfront Services handles full site evaluation, anchoring, gangway setup, and seasonal adjustments.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <GallerySection category="starr-floating-dock" />

    <PopularServices />

    <ReviewsTrustSection topFill="var(--color-cream-50)" bottomFill="var(--color-navy-950)" />

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .challenges-section {
    padding-block: clamp(4rem, 6vw, 6.5rem);
    background: var(--color-white, #ffffff);
  }

  .challenges-section > .site-container,
  .benefits-section > .site-container {
    max-width: clamp(75rem, 85vw, 86rem);
    margin-inline: auto;
  }

  .section-header.text-center {
    text-align: center;
    max-width: 48rem;
    margin: 0 auto clamp(2.5rem, 4vw, 3.5rem);
  }

  .section-eyebrow {
    display: inline-block;
    color: var(--color-gold-600, #b98232);
    font-size: clamp(0.8125rem, 0.78rem + 0.2vw, 0.9375rem);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.65rem;
  }

  .section-heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.8rem + 1.8vw, 3.25rem);
    color: var(--color-navy-950, #041525);
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .section-subheading {
    color: var(--color-text-secondary, #4a5568);
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.2rem);
    line-height: 1.65;
    margin: 0;
  }

  .challenges-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 2vw, 2.25rem);
  }

  .challenge-card {
    padding: clamp(2rem, 2.25vw, 2.5rem);
    border-radius: var(--radius-md, 12px);
    background: var(--color-cream-50, #fcfaf5);
    border: 1px solid var(--color-border-light, #e2e8f0);
    box-shadow: 0 4px 15px -3px rgba(7, 26, 43, 0.05);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .challenge-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: var(--color-navy-950, #041525);
    color: var(--color-gold-400, #dfb15b);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.25rem;
  }

  .challenge-card h3 {
    font-family: var(--font-sans);
    font-size: clamp(1.2rem, 1.12rem + 0.3vw, 1.4rem);
    font-weight: 700;
    color: var(--color-navy-950, #041525);
    margin: 0;
    line-height: 1.3;
  }

  .challenge-card p {
    font-size: clamp(0.975rem, 0.94rem + 0.2vw, 1.075rem);
    line-height: 1.65;
    color: var(--color-text-secondary, #4a5568);
    margin: 0;
  }

  /* Benefits */
  .benefits-section {
    padding-block: clamp(4rem, 6vw, 6.5rem);
    background: var(--color-cream-50, #fcfaf5);
    border-top: 1px solid rgba(7, 26, 43, 0.08);
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2.5rem, 4vw, 4.5rem);
    align-items: start;
  }

  .lead-text {
    font-size: clamp(1.15rem, 1.05rem + 0.35vw, 1.35rem);
    line-height: 1.65;
    color: var(--color-navy-900, #071a2d);
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .benefits-list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .benefits-list li {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .check-wrap {
    flex-shrink: 0;
    margin-top: 0.2rem;
    width: 1.65rem;
    height: 1.65rem;
    border-radius: 50%;
    background: rgba(198, 146, 61, 0.2);
    color: var(--color-gold-600, #b98232);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .benefits-list strong {
    display: block;
    color: var(--color-navy-950, #041525);
    font-size: clamp(1.05rem, 1rem + 0.2vw, 1.175rem);
    margin-bottom: 0.2rem;
  }

  .benefits-list span {
    display: block;
    color: var(--color-text-secondary, #4a5568);
    font-size: clamp(0.95rem, 0.92rem + 0.18vw, 1.05rem);
    line-height: 1.55;
  }

  .cta-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .brochure-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-navy-900, #071a2d);
    font-weight: 700;
    font-size: clamp(0.975rem, 0.94rem + 0.2vw, 1.05rem);
    text-decoration: underline;
    transition: color 200ms var(--ease-premium);
  }

  .brochure-link:hover {
    color: var(--color-gold-600, #b98232);
  }

  /* Specs panel */
  .specs-panel {
    background: var(--color-navy-950, #041525);
    border-radius: var(--radius-md, 12px);
    padding: clamp(2rem, 2.5vw, 2.75rem);
    color: var(--color-white);
    border: 1px solid rgba(198, 146, 61, 0.4);
    box-shadow: 0 15px 35px -10px rgba(7, 26, 43, 0.35);
  }

  .specs-panel h3 {
    font-family: var(--font-sans);
    font-size: clamp(1.35rem, 1.25rem + 0.4vw, 1.65rem);
    font-weight: 700;
    margin: 0 0 0.85rem;
    color: var(--color-white);
  }

  .panel-lead {
    font-size: clamp(0.975rem, 0.94rem + 0.2vw, 1.075rem);
    color: rgba(246, 241, 231, 0.82);
    margin: 0 0 1.5rem;
    line-height: 1.6;
  }

  .size-group {
    margin-bottom: 1.5rem;
  }

  .size-group h4 {
    font-size: clamp(0.85rem, 0.8rem + 0.15vw, 0.95rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold-300, #edd49a);
    margin: 0 0 0.75rem;
  }

  .size-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .size-tag {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-xs, 2px);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-weight: 700;
    font-size: clamp(0.95rem, 0.92rem + 0.2vw, 1.05rem);
    color: var(--color-white);
    letter-spacing: 0.02em;
  }

  .installation-note {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.15rem 1.35rem;
    border-radius: var(--radius-xs, 2px);
    background: rgba(198, 146, 61, 0.15);
    border: 1px solid rgba(198, 146, 61, 0.35);
    margin-top: 1.75rem;
  }

  .installation-note :global(svg) {
    color: var(--color-gold-400, #dfb15b);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .installation-note p {
    margin: 0;
    font-size: clamp(0.925rem, 0.88rem + 0.15vw, 1rem);
    line-height: 1.6;
    color: rgba(246, 241, 231, 0.9);
  }

  .installation-note strong {
    color: var(--color-gold-300, #edd49a);
  }

  @media (max-width: 1024px) {
    .challenges-grid {
      grid-template-columns: 1fr;
    }
    .benefits-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
