---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import { helpfulResources } from "@/data/helpfulResources";

import heroImage from "@/assets/hero/waterfront-hero.png";
---

<BaseLayout title="Helpful Tips & Articles | T&J Waterfront Services">
  <Navbar />

  <main id="main">
    <InteriorHero
      title="Helpful Tips &amp; Articles"
      description="Practical advice from the T&J Waterfront team to help you protect, maintain, and enjoy your waterfront all season long."
      image={heroImage}
      imageAlt="Michigan waterfront by T&J Waterfront Services"
    />

    <section class="articles-section" aria-labelledby="articles-heading">
      <div class="site-container">
        <h2 id="articles-heading">All Of Our Articles</h2>
        <div class="articles-grid">
          {helpfulResources.map((resource) => (
            <a href={resource.url} class="article-card">
              <h3 class="article-title">{resource.description}</h3>
              <p class="article-cta">
                {resource.ctaTextPre}
                <span class="cta-emphasis">{resource.ctaTextEmphasized}</span>
                {resource.ctaTextPost}
              </p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .articles-section {
    background: var(--color-cream-50);
    color: var(--color-text-primary);
    padding-block: clamp(4rem, 6vw, 7rem);
  }

  .articles-section h2 {
    margin: 0 0 clamp(2.5rem, 4vw, 4rem);
    text-align: center;
    color: var(--color-navy-950);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.35rem + 2.4vw, 3.5rem);
    font-weight: 400;
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    max-width: var(--container-lg);
    margin-inline: auto;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    background: var(--color-cream-100);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform var(--duration-base) var(--ease-premium), box-shadow var(--duration-base) var(--ease-premium), border-color var(--duration-base) ease;
  }

  .article-card:hover,
  .article-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-gold-500);
    box-shadow: var(--shadow-soft);
  }

  .article-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--color-navy-950);
  }

  .article-cta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .cta-emphasis {
    color: var(--color-gold-700);
    font-weight: 600;
  }

  @media (max-width: 40rem) {
    .articles-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>