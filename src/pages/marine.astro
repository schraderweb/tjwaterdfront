---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import HubGrid from "@/components/shared/sections/HubGrid.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";
import { marineCards } from "@/data/hubCards";

import heroImage from "@/content/gallery/dock-service-repairs/01.webp";
---

<BaseLayout title="Marine Services | T&J Waterfront Services">
  <Navbar />

  <main id="main">
    <InteriorHero
      title="Marine"
      description="Docks, lifts, boardwalks, and repairs — everything your lakefront needs, installed and serviced by one trusted team."
      image={heroImage}
      imageAlt="Marine services by T&J Waterfront Services"
    />

    <HubGrid
      eyebrow="MARINE"
      title="Marine Services"
      description="From dock systems and boat lifts to boardwalks and repairs, explore our marine services below."
      services={marineCards}
    />

    <PopularServices />

    <ReviewsTrustSection topFill="var(--color-cream-50)" bottomFill="var(--color-navy-950)" />

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>
