---
/**
 * Catch-all interior page — renders a simple placeholder with the page name
 * so every nav/footer link resolves instead of 404ing until the real pages
 * are built out.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";

export function getStaticPaths() {
  const slugs = [
    "services",
    "service-areas",
    "about",
    "contact",
    "services/dock-services",
    "services/lift-accessories",
    "services/boat-lifts",
    "services/sectional-docks",
    "services/roll-in-docks",
    "services/platinum-docks",
    "services/floating-docks",
    "services/dock-accessories",
    "services/dock-services-repair",
    "services/boat-pontoon-lift-accessories",
  ];
  return slugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug ?? "";
const pageNames: Record<string, string> = {
  "services": "Services",
  "service-areas": "Service Areas",
  "about": "About Us",
  "contact": "Contact Us",
  "services/dock-services": "Dock Services & Repair",
  "services/lift-accessories": "Boat & Pontoon Lift Accessories",
  "services/boat-lifts": "Boat Lifts",
  "services/sectional-docks": "Sectional Docks",
  "services/roll-in-docks": "Roll-In Docks",
  "services/platinum-docks": "Platinum Docks",
  "services/floating-docks": "Floating Docks",
  "services/dock-accessories": "Dock Accessories",
  "services/dock-services-repair": "Dock Services & Repair",
  "services/boat-pontoon-lift-accessories": "Boat & Pontoon Lift Accessories",
};
const pageName =
  pageNames[slug] ?? slug.split("/").pop()!.replace(/-/g, " ");
---


<BaseLayout title={`${pageName} | T&J Waterfront Services`}>
  <Navbar />
  <main id="main">
    <section class="placeholder-page">
      <div class="site-container">
        <span class="eyebrow">COME SOON</span>
        <h1>{pageName}</h1>
        <p>We&rsquo;re putting the finishing touches on this page.</p>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .placeholder-page {
    min-height: 60vh;
    display: grid;
    place-items: center;
    text-align: center;
    padding-block: clamp(4rem, 8vw, 8rem);
    background-color: var(--color-cream-50);
  }

  .placeholder-page h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    line-height: 1.05;
    margin: 0.75rem 0 0.5rem;
    color: var(--color-navy-950);
  }

  .placeholder-page p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lead);
  }
</style>
