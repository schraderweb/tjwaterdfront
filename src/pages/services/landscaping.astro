---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navbar from "@/components/shared/layout/Navbar.astro";
import InteriorHero from "@/components/pages/services/InteriorHero.astro";
import ProjectGallery from "@/components/pages/services/ProjectGallery.astro";
import PopularServices from "@/components/shared/sections/PopularServices.astro";
import ReviewsTrustSection from "@/components/shared/sections/ReviewsTrustSection.astro";
import ContactSection from "@/components/shared/sections/ContactSection.astro";
import SiteFooter from "@/components/shared/sections/SiteFooter.astro";

// Placeholder images
import heroImage from "@/assets/hero/waterfront-hero.png";
import starrLift01 from "@/assets/featured-services/starr-lift-01.webp";
import starrLift02 from "@/assets/featured-services/starr-lift-02.webp";
import starrLift03 from "@/assets/featured-services/starr-lift-03.webp";
import starrLift04 from "@/assets/featured-services/starr-lift-04.webp";
import starrLift05 from "@/assets/featured-services/starr-lift-05.webp";
import starrLift06 from "@/assets/featured-services/starr-lift-06.webp";

const galleryImages = [
  { src: starrLift01, alt: "Landscaping project 1", size: "large" as const },
  { src: starrLift02, alt: "Landscaping project 2", size: "tall" as const },
  { src: starrLift03, alt: "Landscaping project 3", size: "wide" as const },
  { src: starrLift04, alt: "Landscaping project 4", size: "medium" as const },
  { src: starrLift05, alt: "Landscaping project 5", size: "small" as const },
  { src: starrLift06, alt: "Landscaping project 6", size: "medium" as const },
];
---

<BaseLayout title="Waterfront Landscaping | T&J Waterfront Services">
  <Navbar />
  
  <main id="main">
    <InteriorHero 
      title="Waterfront Landscaping"
      description="Thoughtfully designed landscapes that enhance your waterfront, complement your property, and are built to withstand Michigan's seasons."
      image={heroImage}
      imageAlt="Beautiful waterfront landscaping by T&J Waterfront Services"
    />

    <ProjectGallery images={galleryImages} />

    <PopularServices />

    <ReviewsTrustSection />

    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>
